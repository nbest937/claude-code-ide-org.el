#!/usr/bin/env bash
# Refuse to push while the archived plans under plans/ are out of date.
#
# Why pre-push and not pre-commit:
#
#   A pre-commit hook that ran bin/sync-plans and staged the result would
#   add files the user never staged -- sweeping unrelated plan edits into
#   a focused commit, and fighting `git add -p`, `--amend` and `stash`.
#   Silently mutating the index is the surprise most likely to cause a
#   "why is that in my commit" incident.
#
#   A pre-commit hook that only *checked* would be worse in a different
#   way: plans change outside this repo, so revising a plan would block
#   every subsequent commit until you synced, including commits with
#   nothing to do with plans. That is a false coupling.
#
#   post-commit would land the sync in the *next* commit, permanently
#   attributing plan changes to the wrong one.
#
#   A push is deliberate, infrequent, and the moment local history becomes
#   shared history. Blocking there costs one command and couples nothing.
#
# What this does NOT do, and cannot: prevent the loss it guards against.
# History is destroyed when a plan is revised *twice* with no sync in
# between -- the intermediate state is then gone from both the working
# copy and the archive. That is a Claude Code event, not a git event, so
# this hook only bounds how stale the archive can be when it is shared.
# Actually closing the window needs a hook on the plan write itself; see
# TODO.org's plan-archive heading.
#
# Bypass with `git push --no-verify` when you mean to.

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
sync="$repo_root/bin/sync-plans"

# Not an error if the script is absent -- an older checkout, or a worktree
# mid-rebase. A hook should never be the reason a push is impossible.
[[ -x "$sync" ]] || exit 0

if ! "$sync" --check >/dev/null 2>&1; then
  echo "pre-push: archived plans under plans/ are out of date." >&2
  echo >&2
  "$sync" --check 2>&1 | sed 's/^/  /' >&2
  echo >&2
  echo "  Fix:  bin/sync-plans && git add plans && git commit" >&2
  echo "  Skip: git push --no-verify" >&2
  exit 1
fi

# Advisory: a merge on main that did not come through a pull request
# (TODO.org :ID: c7bf2121). Ten consecutive integrations used PRs while
# the practice lived only in git history; then two local --no-ff merges
# broke the streak without tripping anything. ADVISORY ONLY, never a
# refusal: a hotfix or a deliberate solo merge must not be blocked by a
# workflow preference -- the retired auto-promotion trigger is this
# repo's precedent for mechanisms that act on their own judgement.
#
# Reads the ref lines git hands every pre-push hook on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r _local_ref local_sha remote_ref remote_sha; do
  [[ "$remote_ref" == "refs/heads/main" ]] || continue
  # A brand-new remote main has no baseline; nothing to compare.
  [[ "$remote_sha" =~ ^0+$ ]] && continue
  # --first-parent, or the range reports merges made *inside* a branch
  # that itself arrived through a PR: `A~1..A' for a merge A includes the
  # whole second-parent history, so one `Merge branch 'main' into
  # feature/x' catch-up produced an advisory naming a merge that did come
  # through a pull request (TODO.org :ID: e0094245). Measured on PR #2,
  # whose range carries two such in-branch merges and now reports none.
  # A genuine local merge into main is still caught: it is a commit on
  # main, so it sits on main's own first-parent chain.
  stray="$(git log --merges --first-parent --format='%h %s' "$remote_sha..$local_sha" 2>/dev/null \
             | grep -Ev '^[0-9a-f]+ Merge pull request' || true)"
  if [[ -n "$stray" ]]; then
    echo "pre-push: advisory -- merge commit(s) on main not from a pull request:" >&2
    printf '%s\n' "$stray" | sed 's/^/    /' >&2
    echo "  the practice is gh pr create, then merge via the PR (TODO.org :ID: c7bf2121)." >&2
    echo "  Pushing anyway; this is a reminder, not a gate." >&2
  fi
done

exit 0
