#!/usr/bin/env bash
# Add the Claude-Session trailer to a commit made from a Claude Code
# session, and leave the Co-Authored-By trailer to the session (TODO.org
# :ID: 6d1a5192-21ad-4316-b0c6-219403459f28).
#
# History. f1ff027e (2026-09-04) made this hook REWRITE every
# "Co-Authored-By: Claude ..." line from the model ~/.claude/settings.json
# names, because the trailer a session typed was frozen at session start
# and went stale after /model. That premise expired: the harness now
# gives each session an exact, versioned trailer, while settings.json
# holds one model for every session, so another session's /model choice
# relabelled this one's commits ("Sonnet 5" on an Opus 5.5 session's
# merges, 2026-11-18), and the hook's alias table lagged the versions
# (every "Opus 5.5" committed as "Opus 5"). The session's own trailer is
# the only trustworthy source, so this hook no longer touches it, and
# does not append one either: a guess from the shared file is worse than
# none. A missing trailer is refused by .githooks/commit-msg instead.
#
# What remains: inside a session (CLAUDECODE=1), append Claude-Session
# from CLAUDE_CODE_BRIDGE_SESSION_ID when the message has none. Through
# git interpret-trailers, which puts the blank line before a new trailer
# block itself -- appending by hand glued the line to the subject of a
# one-line `git merge --no-edit' message.
#
# Fire-and-forget: always exit 0, never block a commit. Plain bash per
# the Emacs-boundary shell decision (:ID: 84b7d8b3) -- a git hook must
# run with no Emacs at all.

set -uo pipefail

msg_file="${1:-}"
[[ -n "$msg_file" && -f "$msg_file" ]] || exit 0
[[ "${CLAUDECODE:-}" == "1" ]] || exit 0
[[ -n "${CLAUDE_CODE_BRIDGE_SESSION_ID:-}" ]] || exit 0

git interpret-trailers --in-place --if-exists doNothing \
  --trailer "Claude-Session: https://claude.ai/code/$CLAUDE_CODE_BRIDGE_SESSION_ID" \
  "$msg_file" 2>/dev/null

exit 0
