#!/usr/bin/env bash
# Prove bin/hooks/apply-detect announces an apply exactly once, stays
# silent everywhere else, and never blocks a prompt. Same register as
# bin/doc-sync-check-test: fixtures in, positive assertions out.
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
hook="$repo_root/bin/hooks/apply-detect"
pass=0 fail=0

check() {
  local desc="$1" want="$2" got="$3"
  if [ "$got" = "$want" ]; then echo "ok   - $desc"; pass=$((pass + 1))
  else echo "FAIL - $desc"; echo "       want: $want"; echo "       got:  $got"; fail=$((fail + 1)); fi
}

qdir="$(mktemp -d)"
trap 'rm -rf "$qdir"' EXIT

run() { # run <session_id>
  printf '{"session_id":"%s"}' "$1" \
    | env CLAUDE_ORG_QUEUE_DIR="$qdir" bash "$hook"
}

# 1. First prompt of a session: silent, but the stamp is initialized.
out="$(run sess-a)"; rc=$?
check "first prompt is silent" "" "$out"
check "first prompt exits 0" "0" "$rc"
check "first prompt creates the stamp" "yes" "$([ -e "$qdir/sess-a.apply-seen" ] && echo yes || echo no)"

# 2. No watermark newer than the stamp: silent.
out="$(run sess-a)"
check "quiet turn is silent" "" "$out"

# 3. A watermark newer than the stamp: announced, on the right channel.
sleep 1
touch "$qdir/other-session.applied"
out="$(run sess-a)"
check "apply is announced" "0" "$(printf '%s' "$out" | jq -e '.hookSpecificOutput.additionalContext | test("applied since")' >/dev/null 2>&1; echo $?)"
check "event name is UserPromptSubmit" "UserPromptSubmit" "$(printf '%s' "$out" | jq -r '.hookSpecificOutput.hookEventName')"
check "announcement counts the watermark" "0" "$(printf '%s' "$out" | jq -e '.hookSpecificOutput.additionalContext | test("1 watermark")' >/dev/null 2>&1; echo $?)"

# 4. Announced once: the stamp advanced, so the next turn is quiet.
out="$(run sess-a)"
check "announcement does not repeat" "" "$out"

# 5. Two sessions are independent: sess-b's first prompt initializes
#    silently even though a watermark exists.
out="$(run sess-b)"
check "a second session initializes silently" "" "$out"

# 6. Garbage stdin: silent, exit 0.
out="$(printf 'not json' | env CLAUDE_ORG_QUEUE_DIR="$qdir" bash "$hook")"; rc=$?
check "garbage stdin is silent" "" "$out"
check "garbage stdin exits 0" "0" "$rc"

# 7. Missing queue directory: silent, exit 0 -- never the reason a
#    prompt fails.
out="$(printf '{"session_id":"x"}' | env CLAUDE_ORG_QUEUE_DIR="$qdir/no-such-dir" bash "$hook")"; rc=$?
check "missing dir is silent" "" "$out"
check "missing dir exits 0" "0" "$rc"

# 8. A jq that fails on the REPORT (not on parsing, which the absence
#    check at the top already covers) must not become the hook's exit
#    status, and must not advance the stamp -- otherwise a real apply is
#    announced to nobody and never mentioned again (TODO.org :ID:
#    31453a5e). The shim passes the parse call through to the real jq and
#    fails only the `-cn' report call, which is the only way to reach the
#    final jq at all.
shimdir="$(mktemp -d)"
real_jq="$(command -v jq)"
cat >"$shimdir/jq" <<EOF
#!/usr/bin/env bash
[ "\$1" = "-cn" ] && exit 1
exec "$real_jq" "\$@"
EOF
chmod +x "$shimdir/jq"

qdir2="$(mktemp -d)"
run2() { printf '{"session_id":"%s"}' "$1" \
           | env CLAUDE_ORG_QUEUE_DIR="$qdir2" PATH="$shimdir:$PATH" bash "$hook"; }

run2 sess-c >/dev/null                       # initialize the stamp
sleep 1
touch "$qdir2/some-session.applied"          # an apply to report
out="$(run2 sess-c)"; rc=$?
check "a failing report does not fail the hook" "0" "$rc"
check "a failing report emits nothing" "" "$out"

# The stamp stayed put, so the apply is still owed -- with a working jq
# the very next turn announces it.
out="$(printf '{"session_id":"sess-c"}' | env CLAUDE_ORG_QUEUE_DIR="$qdir2" bash "$hook")"
check "an unreported apply is announced on the next turn" "0" \
  "$(printf '%s' "$out" | jq -e '.hookSpecificOutput.additionalContext | test("applied since")' >/dev/null 2>&1; echo $?)"

rm -rf "$shimdir" "$qdir2"

# 9. The discriminator (TODO.org :ID: 7b4f4f14). --queue-watermark-write
#    rewrites the file on every pass, including one that only dismissed
#    events, so the mtime lies; each `applied' entry's value is the time
#    of the pass that applied it, and a dismiss-only pass leaves those
#    unchanged. The hook reports only when a watermark's newest value
#    differs from the one it last recorded.
qdir3="$(mktemp -d)"
run3() { printf '{"session_id":"%s"}' "$1" \
           | env CLAUDE_ORG_QUEUE_DIR="$qdir3" bash "$hook"; }
wm() { # wm <name> <dismissed-json> <event>=<pass> ...
  local name="$1" dismissed="$2"; shift 2
  local applied="{}"
  for pair in "$@"; do
    applied="$(jq -c --arg e "${pair%%=*}" --arg p "${pair#*=}" '. + {($e): $p}' <<<"$applied")"
  done
  jq -nc --argjson a "$applied" --argjson d "$dismissed" '{applied: $a, dismissed: $d}' \
    > "$qdir3/$name.applied"
}
announced() { printf '%s' "$1" | jq -e '.hookSpecificOutput.additionalContext | test("applied since")' >/dev/null 2>&1 && echo yes || echo no; }

wm s1 '{}' e1=2026-09-23T19:20:23-0500
run3 sess-d >/dev/null                        # first prompt: record every value
check "the record holds the watermark's newest value" "yes" \
  "$(grep -q $'^s1.applied\t2026-09-23T19:20:23-0500$' "$qdir3/sess-d.apply-seen" && echo yes || echo no)"
sleep 1
wm s1 '{"x":"stale"}' e1=2026-09-23T19:20:23-0500   # dismiss-only: rewritten, values unchanged
out="$(run3 sess-d)"
check "a dismiss-only rewrite reports nothing" "" "$out"
sleep 1
wm s1 '{"x":"stale"}' e1=2026-09-23T19:20:23-0500 e2=2026-09-24T09:47:04-0500
out="$(run3 sess-d)"
check "an apply is reported" "yes" "$(announced "$out")"
check "and counted" "0" "$(printf '%s' "$out" | jq -e '.hookSpecificOutput.additionalContext | test("1 watermark")' >/dev/null 2>&1; echo $?)"
check "and not repeated" "" "$(run3 sess-d)"
sleep 1
wm s2 '{}' e1=2026-09-24T10:00:00-0500          # a watermark the record has never seen
check "a new watermark is reported" "yes" "$(announced "$(run3 sess-d)")"
sleep 1
# A first pass that only dismissed (TODO.org :ID: 7e4e70af, PR #31
# review): a watermark the record has never seen, with no applied value,
# is not an apply.
wm s5 '{"x":"stale"}'
check "a new dismiss-only watermark reports nothing" "" "$(run3 sess-d)"
sleep 1
printf 'not json at all' > "$qdir3/s3.applied"
check "an unparseable watermark falls back to its mtime and is reported" "yes" "$(announced "$(run3 sess-d)")"
check "and once only" "" "$(run3 sess-d)"
sleep 1
wm s4 '{}' e1=2026-11-01T01:30:00-0600           # recorded with the winter offset
run3 sess-d >/dev/null
sleep 1
touch "$qdir3/s4.applied"                        # moved, value unchanged
check "a value recorded across a DST change still matches" "" "$(run3 sess-d)"

# 10. A legacy empty stamp (every one on disk on 2026-09-24) records the
#     current values silently, exactly like a first prompt.
: > "$qdir3/sess-e.apply-seen"
sleep 1
touch "$qdir3/s1.applied"
check "a legacy empty stamp initialises silently" "" "$(run3 sess-e)"
check "and is now a record" "yes" "$([ -s "$qdir3/sess-e.apply-seen" ] && echo yes || echo no)"
sleep 1
wm s1 '{}' e1=2026-09-23T19:20:23-0500 e2=2026-09-24T09:47:04-0500 e3=2026-09-25T08:00:00-0500
check "after which a real apply is reported" "yes" "$(announced "$(run3 sess-e)")"

rm -rf "$qdir3"

echo
echo "apply-detect-test: $pass passed, $fail failed"
exit $((fail > 0))
