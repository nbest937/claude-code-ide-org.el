#!/bin/sh
# Doctest-style content-accuracy check for .claude/skills/org-dev/SKILL.md.
#
# Thin stub since 2026-09-04 (TODO.org :ID: 84b7d8b3): this doctest
# NEEDS the running Emacs -- the MCP port, loaded org facilities and
# Doom settings are live state -- so per the Emacs-boundary split its
# logic lives in bin/lib/check-org-dev-skill.el, loaded into that Emacs,
# and this wrapper only moves bytes: invoke, cat the report, exit on the
# returned verdict.  POSIX sh; nothing left here needs more.  The fish
# original shelled out to emacsclient seven times for what is now one
# round-trip.
#
# The load path is THIS checkout's copy, so a worktree checks its own
# claims even though the serving Emacs loaded another checkout's module
# (the same distinction TODO.org :ID: f8c86914 settled for the
# capture-file comparison).

script_dir=$(cd "$(dirname "$0")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)

out=$(mktemp) || exit 1
verdict=$(emacsclient -e "(progn (load \"$script_dir/lib/check-org-dev-skill.el\" nil t) (claude-code-ide-org-dev-skill-check \"$repo_root\" \"$out\"))" 2>/dev/null)

if [ -z "$verdict" ]; then
  # Unreachable server is a FAIL, not a skip: a human running this by
  # hand asked for checks that only a live Emacs can answer, and a
  # silent drop would read as a pass.  The commit gate never reaches
  # this -- .githooks/pre-commit passes --docs-only, which skips the
  # delegation entirely.
  echo "FAIL - check-org-dev-skill: emacsclient unreachable (every check here asks the running Emacs)"
  rm -f "$out"
  exit 1
fi

cat "$out"
rm -f "$out"

[ "$verdict" = "0" ] && exit 0 || exit 1
