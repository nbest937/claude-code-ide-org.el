#!/usr/bin/env bash
# Promote the plugin's convention and machinery rules into a consuming
# repo's .claude/rules/, so they load in every session there instead of
# only when someone thinks to read a skill reference (the distribution
# decision recorded on TODO.org :ID: 9ae4b17e: plugins cannot contribute
# rules files themselves, so a setup command is the delivery mechanism —
# per-repo, full strength, consent-by-install).
#
# Run it from the consuming repo's root. Re-run it after a plugin update
# to refresh the copies. The claude-code-ide-org repo runs it on itself:
# its machinery rules under .claude/rules/ are generated by this script.
#
# Survive-without-Emacs tier (CLAUDE.md "Scripting conventions"): plain
# bash, no emacsclient, no jq.

set -euo pipefail

marker="Generated by claude-org-setup"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
plugin_root="$(cd "$script_dir/.." && pwd)"
refs="$plugin_root/skills/org/references"

# Promoted set: the path-scoped conventions plus the five always-loaded
# machinery rules. org-emacs-setup.md and org-time-tracking-internals.md
# are deliberately absent — both are
# install-time reading, not per-session context.
#
# org-footnote-citations.md carries no path scope on purpose (TODO.org
# :ID: fc70b56d): an id gets cited in a response about source, tests or
# commits, with no .org file in play, so a path-scoped copy would be a
# rule that does not load — and bin/hooks/footnote-check ships enforcing
# it either way.
promote=(org-conventions.md org-event-queue.md org-state-transitions.md
         org-mcp-tools.md org-session-tracking.md org-footnote-citations.md)

# Time-tracking rules: promoted only where time tracking is on (TODO.org
# :ID: 1b69fe4e). Until 2026-09-19 this was unconditional, on the premise
# that it "costs a consumer one unread reference". It does not: the file
# carries no path scope, so promoted it is loaded at launch by every
# session -- 260 lines about a feature that defaults to off.
#
# The constraint behind the old choice is real: the `time_tracking'
# userConfig option is read by the hook scripts at run time and this
# script cannot see it. So the FEATURE's gate stays in the scripts, and
# the PROSE gets its own, decided after the arguments are parsed (below)
# from the three signals this script can see. Unpromoted, the file is
# still in skills/org/references/, as install-time reading.
time_file=org-time-tracking.md

force=0
check=0
doom=0
org=0
time_flag=0
time_off=0
time_kept=0
target="$PWD"
for a in "$@"; do
  case "$a" in
    --force) force=1 ;;
    --check) check=1 ;;
    --doom) doom=1 ;;
    --org) org=1 ;;
    --time-tracking) time_flag=1 ;;
    --no-time-tracking) time_off=1 ;;
    --*)
      echo "claude-org-setup: unknown option: $a" >&2
      echo "usage: claude-org-setup [--force|--check|--doom|--org|--time-tracking|--no-time-tracking] [TARGET_DIR]" >&2
      exit 2
      ;;
    *)
      if ! target="$(cd "$a" 2>/dev/null && pwd)"; then
        echo "claude-org-setup: not a directory: $a" >&2
        exit 2
      fi
      ;;
  esac
done

# Is time tracking on? Any one of: the flag; the variable the hooks
# themselves read, when the caller's environment happens to carry it; or
# a target whose own .claude/settings.json sets that variable in a hook
# command -- which is what "wiring the row is the opt-in" means for a
# repo that wires the scripts itself rather than through the plugin.
time_on=0
[ "$time_flag" = 1 ] && time_on=1
[ "${CLAUDE_PLUGIN_OPTION_TIME_TRACKING:-}" = "true" ] && time_on=1
grep -q 'CLAUDE_PLUGIN_OPTION_TIME_TRACKING=true' "$target/.claude/settings.json" 2>/dev/null && time_on=1
# Off is said only explicitly: --no-time-tracking, or the variable set to
# false. Setup cannot see a plugin consumer's option, so silence is not
# off -- a generated copy already present is the earlier decision and is
# kept, the same rule --check applies (PR #29 review, TODO.org :ID:
# 5fbc34cb). Before, a plain re-run deleted the time rules of a consumer
# with tracking on, and the pre-commit guard's own hint is a plain re-run.
[ "${CLAUDE_PLUGIN_OPTION_TIME_TRACKING:-}" = "false" ] && time_off=1
if [ "$time_on" = 0 ] && [ "$time_off" = 0 ] \
   && grep -q "$marker" "$target/.claude/rules/$time_file" 2>/dev/null; then
  time_on=1 time_kept=1
fi
[ "$time_on" = 1 ] && promote+=("$time_file")

# Session names (TODO.org :ID: 965f94eb). The wiring registers each
# tracked project under the session name its emacs-tools URL ends in,
# resolved as Claude Code resolves it: a local-scope entry in
# ~/.claude.json for that directory first, else its .mcp.json. Two clones
# of one repo resolve to the same name and the wiring refuses; the fix is
# one local-scope `claude mcp add' in the second clone, which setup
# PROPOSES and never runs -- ~/.claude.json is Claude Code's file.
resolve_session_name() { # dir -> name
  local dir="${1%/}" url="" phys
  # Keyed by the directory as Claude Code saw it, which may be the
  # physical path (/private/var for /var on macOS), so both are asked.
  phys="$(cd "$dir" 2>/dev/null && pwd -P || printf '%s' "$dir")"
  if command -v jq >/dev/null 2>&1; then
    url="$(jq -r --arg d "$dir" --arg p "$phys" \
             '(.projects[$d] // .projects[$p]).mcpServers["emacs-tools"].url // empty' \
             "$HOME/.claude.json" 2>/dev/null || true)"
    [ -n "$url" ] || url="$(jq -r '.mcpServers["emacs-tools"].url // empty' \
                               "$dir/.mcp.json" 2>/dev/null || true)"
  fi
  if [ -n "$url" ]; then
    printf '%s\n' "$url" | sed -E 's|/*$||; s|.*/mcp/||'
  else
    basename "$dir"
  fi
}
# The tracked projects, from the agenda list file setup already appends
# to: each listed file's git root, once each, existing ones only.
tracked_projects() {
  local listfile="${CLAUDE_ORG_AGENDA_LIST:-$HOME/org/agenda-files}" f d
  [ -r "$listfile" ] || return 0
  while IFS= read -r f; do
    f="${f/#\~/$HOME}"
    [ -e "$f" ] || continue
    d="$(git -C "$(dirname "$f")" rev-parse --show-toplevel 2>/dev/null || dirname "$f")"
    printf '%s\n' "$d"
  done < "$listfile" | sort -u
}
# Another tracked project that already resolves to NAME, other than DIR.
session_taken_by() { # name dir -> the other project's dir, or nothing
  local name="$1" me other
  me="$(cd "$2" 2>/dev/null && pwd -P)"
  tracked_projects | while IFS= read -r other; do
    [ "$(cd "$other" 2>/dev/null && pwd -P)" = "$me" ] && continue
    if [ "$(resolve_session_name "$other")" = "$name" ]; then printf '%s\n' "$other"; break; fi
  done
}

# There is no --glue any more (TODO.org :ID: c562b69a). The generated
# Doom glue held three fixed forms once its per-machine project list
# became derived, and a fixed text kept as a generated copy can only
# drift, so the forms moved into the module, run whenever it is enabled.
# --check reports a leftover glue file or its load! line as obsolete.

# --org: scaffold the consuming project's org files from the shipped
# templates (TODO.org :ID: 9b171907), collision-checked -- an existing
# file is never touched, only reported -- then append the ignore
# entries the consumer needs and create the project-scope skill link
# (TODO.org :ID: 784d80c5). When the user keeps org's
# agenda list file (~/org/agenda-files, TODO.org :ID: 308bf4b4) the
# scaffolded paths are APPENDED to it -- org re-reads that file on
# every access, so discovery is immediate: no symlink, no restart.
# Without a list file the follow-up acts are PRINTED, same boundary as
# --doom: they touch the user's world, so the user performs them.
if [ "$org" = 1 ]; then
  tdir="$plugin_root/templates"
  wrote=0
  for f in TODO.org DONE.org; do
    if [ ! -f "$tdir/$f" ]; then
      echo "claude-org-setup: missing template: $tdir/$f" >&2
      exit 1
    fi
    if [ -e "$target/$f" ]; then
      echo "exists:  $target/$f (left untouched)"
    else
      cp "$tdir/$f" "$target/$f"
      echo "created: $target/$f"
      wrote=$((wrote + 1))
    fi
  done

  # The consumer's own .mcp.json (TODO.org :ID: 805bf287). Without it a
  # consuming repo gets the hooks, the rules and the skill but NO org
  # tools at all -- which is the entire product -- because nothing names
  # the MCP server. Measured 2026-09-18 in a real consumer: `claude mcp
  # list' showed emacs-tools here and nothing there.
  #
  # It cannot ship with the plugin, which is why this generates it. The
  # URL carries a SESSION NAME, `claude-code-ide-org-standalone-wire'
  # registers one session per tracked project under its directory
  # basename, and that basename is by definition unknown at packaging
  # time. A static shipped file can only ever name someone else's
  # project. (The plugin used to declare one naming a fixed alias that
  # resolved to whichever project sorted FIRST in org-agenda-files
  # order, so it was not stable even here. Both the declaration and the
  # alias are gone -- TODO.org :ID: 27e16e9a.)
  #
  # The port is read from the plugin's own .mcp.json rather than
  # written twice: that file is what `claude-code-ide-org--mcp-json-port'
  # checks the live server against, so there is exactly one place a port
  # can be wrong.
  #
  # Collision-checked like the org templates: an existing file is
  # reported and left alone, never merged. A consumer may already have
  # MCP servers of their own, and a blind overwrite would take them out.
  # `|| true' below: under set -e and pipefail a missing $mcp_src fails
  # the substitution and kills the script there, so the "no port found;
  # skipping" branch was unreachable -- found 2026-09-19 by a test
  # fixture with no .mcp.json (TODO.org :ID: 94e6b615).
  mcp_src="$plugin_root/.mcp.json"
  mcp_dest="$target/.mcp.json"
  mcp_port="$(sed -n 's|.*http://localhost:\([0-9][0-9]*\)/mcp/.*|\1|p' "$mcp_src" 2>/dev/null | head -1 || true)"
  # A name another tracked project already resolves to (TODO.org :ID:
  # 965f94eb). Asked whatever .mcp.json's state, because the usual case
  # is a second clone of a repo that commits one: the file is shared by
  # every clone and stays as it is; this clone gets its own name locally.
  if [ -n "$mcp_port" ]; then
    own="$(resolve_session_name "$target")"
    taken="$(session_taken_by "$own" "$target")"
    if [ -n "$taken" ]; then
      echo "ACTION:  the MCP session name \"$own\" is taken by $taken."
      echo "         In this clone, run once (setup does not):"
      echo ""
      echo "           claude mcp add --scope local --transport http emacs-tools http://localhost:$mcp_port/mcp/$own-2"
      echo ""
      mcp_action=1
    fi
  fi
  if [ -z "$mcp_port" ]; then
    echo "claude-org-setup: no port found in $mcp_src; skipping .mcp.json" >&2
  elif [ -e "$mcp_dest" ]; then
    # Never merged -- a consumer may have MCP servers of their own and a
    # blind overwrite would take them out. But this cannot be SILENT the
    # way the org templates can: a pre-existing .mcp.json without an
    # emacs-tools entry means no org tools at all, which is the entire
    # product, and one unremarkable `exists:' line among a dozen is not a
    # warning (review finding on PR #28). So say what is missing, and
    # print the exact block rather than describing it.
    if grep -q '"emacs-tools"' "$mcp_dest" 2>/dev/null; then
      echo "exists:  $mcp_dest (left untouched; names emacs-tools already)"
    else
      echo "ACTION:  $mcp_dest exists but names no emacs-tools server."
      echo "         Without it this project gets no org_* tools at all."
      echo "         Merge this into its mcpServers object by hand:"
      echo ""
      echo "             \"emacs-tools\": {"
      echo "               \"type\": \"http\","
      echo "               \"url\": \"http://localhost:$mcp_port/mcp/$(basename "$target")\""
      echo "             }"
      echo ""
      mcp_action=1
    fi
  else
    session="$(basename "$target")"
    cat > "$mcp_dest" <<MCPEOF
{
  "mcpServers": {
    "emacs-tools": {
      "type": "http",
      "url": "http://localhost:$mcp_port/mcp/$session"
    }
  }
}
MCPEOF
    echo "created: $mcp_dest (session \"$session\", port $mcp_port)"
    wrote=$((wrote + 1))
  fi

  # The consuming repo's .gitignore (TODO.org :ID: 784d80c5): appended
  # to, never clobbered, with the same exact-line dedupe the agenda
  # list gets below, and created when absent. Four entries every
  # consumer needs: settings.local.json and worktrees/ are Claude
  # Code's per-clone state; clock-status.json and the audit jsonl are
  # this module's runtime state, written into the project root.
  ignore="$target/.gitignore"
  ignored=0
  # A hand-kept file may end without a newline; appending straight
  # after it would glue the first new entry onto the last old line.
  # Shared with the agenda-list append below, which had the same
  # exposure (PR #24 review).
  append_line() { # file line
    if [ -s "$1" ] && [ -n "$(tail -c1 "$1")" ]; then
      printf '\n' >> "$1"
    fi
    printf '%s\n' "$2" >> "$1"
  }
  ensure_ignored() { # line
    if ! grep -qxF "$1" "$ignore" 2>/dev/null; then
      append_line "$ignore" "$1"
      ignored=$((ignored + 1))
    fi
  }
  for line in .claude/settings.local.json .claude/worktrees/ \
              clock-status.json .claude-code-ide-org-audit.jsonl; do
    ensure_ignored "$line"
  done

  # The project-scope skill link that enables the plugin here (the
  # org-emacs-setup reference, "Per-repo setup"). RELATIVE when the
  # clone is a sibling of the target: then the committed link is
  # provenance and enablement in one artifact, working wherever the
  # clones are siblings and dangling harmlessly where they are not.
  # ABSOLUTE otherwise, and then gitignored -- a machine's path is not
  # the project's to commit. So the ignore line is for the absolute
  # form only; a relative link should be committed. A submodule was
  # considered and declined: a vendored second clone breaks the
  # per-clone port contract and forks the plugin revision per
  # consumer. Skipped when a user-scope link already enables the
  # plugin everywhere, since both at once would load it twice -- and
  # skipped when the target IS the plugin, which would make the repo
  # its own consumer and wire its hooks twice (PR #24 review).
  #
  # The link is NAMED by the plugin's fixed name, which is what the
  # docs prescribe for the user-scope link too, so the guard compares
  # like with like whatever the clone's directory is called; only the
  # relative TARGET uses the directory name.
  pname="claude-code-ide-org"
  pdir="$(basename "$plugin_root")"
  link="$target/.claude/skills/$pname"
  if [ "$plugin_root" = "$target" ]; then
    echo "skipped: $link -- the target is the plugin itself"
  elif [ -e "$link" ] || [ -L "$link" ]; then
    echo "exists:  $link (left untouched)"
  elif [ -e "$HOME/.claude/skills/$pname" ] || [ -L "$HOME/.claude/skills/$pname" ]; then
    echo "skipped: $link -- ~/.claude/skills/$pname already enables the plugin user-wide"
  else
    mkdir -p "$target/.claude/skills"
    if [ "$(dirname "$plugin_root")" = "$(dirname "$target")" ]; then
      ln -s "../../../$pdir" "$link"
      echo "linked:  $link -> ../../../$pdir (relative: commit it)"
    else
      ln -s "$plugin_root" "$link"
      ensure_ignored ".claude/skills/$pname"
      echo "linked:  $link -> $plugin_root (absolute: gitignored)"
    fi
  fi
  echo "ignored: appended $ignored line(s) to $ignore"

  name="$(basename "$target")"
  listfile="${CLAUDE_ORG_AGENDA_LIST:-$HOME/org/agenda-files}"
  if [ -f "$listfile" ]; then
    appended=0
    for f in TODO.org DONE.org; do
      path="$target/$f"
      tilde="~${path#"$HOME"}"
      # Dedup against both spellings a hand-kept file may use.
      if ! grep -qxF "$path" "$listfile" && ! grep -qxF "$tilde" "$listfile"; then
        append_line "$listfile" "$path"
        appended=$((appended + 1))
      fi
    done
    cat <<EOF

Scaffolded $wrote file(s); appended $appended path(s) to $listfile.
org re-reads that file on every access: discoverable NOW, no symlink,
no restart. The header lines are load-bearing: the #+TODO: cookies
drive state logging and #+STARTUP: logdrawer keeps notes in :LOGBOOK:.

Two follow-ups only you can do:

1. Register the project's MCP session (or let the next Emacs start
   do it):

     emacsclient -e '(claude-code-ide-org-standalone-wire)'

2. If the machinery rules are not promoted here yet, also run:

     claude-org-setup

Targetless org_capture calls from sessions in this project land in
its own TODO.org immediately -- pass category= on each, since a
top-level heading cannot inherit one.
EOF
  else
    cat <<EOF

Scaffolded $wrote file(s). The header lines are load-bearing: the
#+TODO: cookies drive state logging and #+STARTUP: logdrawer keeps
notes in :LOGBOOK:.

No agenda list file at $listfile -- printing the follow-ups
only you can do. (Adopting the list file makes this step automatic:
point org-agenda-files at that file name and re-run; see the
org-emacs-setup reference.)

1. Make the files discoverable (org-agenda-files scans ~/org once at
   config load):

     mkdir -p ~/org/$name
     ln -s "$target/TODO.org" ~/org/$name/TODO.org
     ln -s "$target/DONE.org" ~/org/$name/DONE.org

   then RESTART Emacs -- or add them to the running one now:

     emacsclient -e '(dolist (f (list "~/org/$name/TODO.org" "~/org/$name/DONE.org")) (add-to-list (quote org-agenda-files) (expand-file-name f)))'

2. Register the project's MCP session:

     M-x claude-code-ide-org-standalone-wire

   (with the module's 'derive setting it picks up every tracked
   project; a hand-kept claude-code-ide-org-standalone-projects list
   needs this project added first.)

3. If the machinery rules are not promoted here yet, also run:

     claude-org-setup

Targetless org_capture calls from sessions in this project will land
in its own TODO.org once step 1 makes it discoverable -- pass
category= on each, since a top-level heading cannot inherit one.
EOF
  fi
  exit 0
fi

# --doom: print the two init.el lines that wire the Doom module from
# this checkout (TODO.org :ID: 78a02667). Print-only, deliberately:
# init.el is the user's file (1caed585's boundary), and since Doom's
# `doom-module-load-path' accepts extra module-tree roots there is
# nothing on disk to create -- no symlink, nothing to clean up.
# (That variable is marked deprecated-for-v3 in Doom's own source;
# re-verify this advice at a Doom upgrade.)
if [ "$doom" = 1 ]; then
  if [ ! -e "$plugin_root/.git" ]; then
    # An update-managed plugin copy (marketplace/zip) is replaced on
    # every update, so a load-path entry into it points at churn.
    echo "claude-org-setup: this plugin directory is not a git checkout:" >&2
    echo "  $plugin_root" >&2
    echo "a module path into an update-managed copy breaks on every plugin" >&2
    echo "update -- clone the repo and run bin/claude-org-setup --doom from" >&2
    echo "the clone instead" >&2
    exit 1
  fi
  cat <<EOF
Add to ~/.config/doom/init.el, BEFORE the doom! block:

  (add-to-list 'doom-module-load-path "$plugin_root/modules")

and inside the doom! block, under :tools:

  claude-code-ide-org

then run 'doom sync' and restart Emacs. Nothing was written; both
edits are yours to make.
EOF
  exit 0
fi

rules_dir="$target/.claude/rules"

missing=0
for f in "${promote[@]}"; do
  [ -f "$refs/$f" ] || { echo "claude-org-setup: missing reference: $refs/$f" >&2; missing=1; }
done
[ "$missing" = 0 ] || exit 1

provenance() {
  cat <<EOF
<!-- $marker from the claude-code-ide-org plugin.
     Do not edit: changes belong in the plugin's
     skills/org/references/$1 — re-run claude-org-setup to refresh.
     This project's own rules take priority over these. -->
EOF
}

# Render what promotion would write for reference $1 into file $2.
render() {
  if [ "$(head -1 "$refs/$1")" = "---" ]; then
    # Keep YAML frontmatter first — path scoping only works when it
    # opens the file — and slot the provenance comment just after it.
    # (BSD awk refuses newlines in -v strings, hence head/tail.)
    local fm_end
    fm_end="$(awk 'NR>1 && /^---$/ {print NR; exit}' "$refs/$1")"
    if [ -z "$fm_end" ]; then
      echo "claude-org-setup: unterminated frontmatter in $refs/$1" >&2
      exit 1
    fi
    { head -n "$fm_end" "$refs/$1"; echo; provenance "$1"
      tail -n "+$((fm_end + 1))" "$refs/$1"; } > "$2"
  else
    { provenance "$1"; echo; cat "$refs/$1"; } > "$2"
  fi
}

# --check: report drift between the promoted copies and what promotion
# would write today (TODO.org :ID: 85d24dba — a copy goes stale until
# this is re-run, and staleness lands in always-loaded rules). Compares
# against the RENDERED form, so the provenance header never reads as
# drift. Exit 1 on any drifted or missing copy; writes nothing.
if [ "$check" = 1 ]; then
  drifted=0
  # --check takes the file's PRESENCE as the signal rather than deciding
  # again: a copy this script wrote is checked for drift however the
  # feature was switched on, and an absent one is not called missing.
  if [ "$time_on" = 0 ] && grep -q "$marker" "$rules_dir/$time_file" 2>/dev/null; then
    promote+=("$time_file")
  fi
  for f in "${promote[@]}"; do
    dest="$rules_dir/$f"
    if [ ! -f "$dest" ]; then
      echo "missing: $dest (run claude-org-setup)"
      drifted=1
      continue
    fi
    tmp="$(mktemp)"
    render "$f" "$tmp"
    if cmp -s "$tmp" "$dest"; then
      echo "ok:      $dest"
    else
      echo "drifted: $dest (re-run claude-org-setup to refresh)"
      drifted=1
    fi
    rm -f "$tmp"
  done

  # The user's Doom config, read-only (TODO.org :ID: c562b69a). The
  # wiring lives in the module now, so the generated glue file and the
  # load! line that loaded it are obsolete, and a leftover of either is
  # reported for deletion -- which is how the one-time migration gets
  # noticed. Both are harmless meanwhile: the wiring is idempotent.
  doomdir="${DOOMDIR:-$HOME/.config/doom}"
  if [ ! -d "$doomdir" ]; then
    echo "skipped: no Doom config at $doomdir (nothing to check)"
  else
    if [ -f "$doomdir/claude-code-ide-org-glue.el" ]; then
      echo "obsolete: $doomdir/claude-code-ide-org-glue.el -- the module wires itself now; delete it"
      drifted=1
    else
      echo "ok:      no generated glue in $doomdir"
    fi
    if grep -q 'claude-code-ide-org-glue' "$doomdir/config.el" 2>/dev/null; then
      echo "obsolete: the load! line for claude-code-ide-org-glue in $doomdir/config.el -- delete it"
      drifted=1
    else
      echo "ok:      no glue load! line in $doomdir/config.el"
    fi
    # A hand-kept 202 override is redundant too: the module has shipped
    # it as gated advice since 2026-09-15 (:ID: af2f345e),
    # so a live copy in the user's config is redundant and shadows it.
    if grep -qE '^[[:space:]]*\(defun claude-code-ide-mcp-http-server--send-empty-response' \
         "$doomdir/config.el" 2>/dev/null; then
      echo "drifted: $doomdir/config.el still defines a 202 override -- the module ships it now; delete it"
      drifted=1
    else
      echo "ok:      no stale 202 override in $doomdir/config.el"
    fi
  fi

  # The consumer's own .mcp.json (review finding on PR #28). Checked
  # here rather than only named in the footer below, because it is the
  # one artifact whose staleness means NO TOOLS AT ALL: the session name
  # is baked in at --org time, so a clone under another name, a directory
  # rename, or a port change in the plugin's own .mcp.json all leave a
  # file that resolves to a session `standalone-wire' never registered.
  # Only the session name and port are asserted -- not the whole file --
  # because a consumer may legitimately have added servers of their own.
  mcp_src="$plugin_root/.mcp.json"
  mcp_dest="$target/.mcp.json"
  mcp_port="$(sed -n 's|.*http://localhost:\([0-9][0-9]*\)/mcp/.*|\1|p' "$mcp_src" 2>/dev/null | head -1 || true)"
  want_url="http://localhost:$mcp_port/mcp/$(basename "$target")"
  if [ ! -f "$mcp_dest" ]; then
    echo "missing: $mcp_dest -- this project has no org tools (run claude-org-setup --org)"
    drifted=1
  elif grep -qF "$want_url" "$mcp_dest" 2>/dev/null; then
    echo "ok:      $mcp_dest names $want_url"
  else
    echo "drifted: $mcp_dest does not name $want_url"
    echo "         (a renamed directory, a clone under another name, or a port change)"
    drifted=1
  fi

  # Two tracked projects on one session name: the wiring refuses them,
  # so the check names it too (TODO.org :ID: 965f94eb).
  if [ -d "$target" ]; then
    own="$(resolve_session_name "$target")"
    taken="$(session_taken_by "$own" "$target")"
    if [ -n "$taken" ]; then
      echo "collision: $target and $taken both resolve to MCP session \"$own\""
      echo "         in one of them: claude mcp add --scope local --transport http emacs-tools http://localhost:$mcp_port/mcp/$own-2"
      drifted=1
    else
      echo "ok:      MCP session \"$own\" is this project's alone"
    fi
  fi

  # Say what was NOT checked. The heading this closes exists because a
  # clean run read as "up to date" and meant "the rules match"; naming
  # the gaps is half the fix and the cheaper half.
  echo
  echo "Checked: promoted rules, obsolete Doom glue, this project's .mcp.json."
  echo "NOT checked: whether the running Emacs has loaded the current"
  echo "  module (needs a digest; TODO.org :ID: 2cd74268), or the"
  echo "  time_tracking option -- that is per-user and lives in"
  echo "  ~/.claude/settings.json; a session reports it at SessionStart."
  exit "$drifted"
fi

# Refuse to clobber a hand-maintained file: only files this script wrote
# (identified by the marker) are overwritten without --force.
blocked=()
for f in "${promote[@]}"; do
  dest="$rules_dir/$f"
  if [ -f "$dest" ] && ! grep -q "$marker" "$dest" && [ "$force" = 0 ]; then
    blocked+=("$dest")
  fi
done
if [ "${#blocked[@]}" -gt 0 ]; then
  echo "claude-org-setup: refusing to overwrite hand-maintained file(s):" >&2
  printf '  %s\n' "${blocked[@]}" >&2
  echo "re-run with --force to replace them" >&2
  exit 1
fi

mkdir -p "$rules_dir"

wrote=0
for f in "${promote[@]}"; do
  dest="$rules_dir/$f"
  tmp="$(mktemp)"
  render "$f" "$tmp"
  mv "$tmp" "$dest"
  chmod 644 "$dest"  # mktemp defaults to 600
  wrote=$((wrote + 1))
  echo "wrote $dest"
done

# Off, and a copy this script wrote is still here: remove it rather than
# orphan it. Only a generated copy -- the marker is the licence, exactly
# as it is for overwriting. This is the removal case TODO.org :ID:
# 96ad6e95 says nothing handles, for this one file.
if [ "$time_off" = 1 ] && grep -q "$marker" "$rules_dir/$time_file" 2>/dev/null; then
  rm -f "$rules_dir/$time_file"
  echo "removed $rules_dir/$time_file (time tracking is off; --time-tracking promotes it)"
fi
[ "$time_kept" = 1 ] && echo "kept $rules_dir/$time_file (already promoted; --no-time-tracking removes it)"

echo "claude-org-setup: promoted $wrote rule file(s) into $rules_dir"
