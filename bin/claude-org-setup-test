#!/usr/bin/env bash
# Prove bin/claude-org-setup's behaviour against a temp target:
# promotion writes every file with the marker, frontmatter stays first
# where the reference has one, an unmarked existing file refuses without
# --force and yields to it, and a re-run is idempotent. Runs the real
# script against the real references — the point is the promotion
# mechanics, not fixture content.

set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
setup="$script_dir/claude-org-setup"

checks=0
fails=0
check() { # label verdict
  checks=$((checks + 1))
  if [ "$2" = ok ]; then
    echo "ok   $1"
  else
    fails=$((fails + 1))
    echo "FAIL $1: $2"
  fi
}

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# 1. Fresh promotion writes all five files, each carrying the marker.
out="$("$setup" "$tmp" 2>&1)"; rc=$?
check "fresh run exits 0" "$([ $rc -eq 0 ] && echo ok || echo "rc=$rc: $out")"
n="$(ls "$tmp/.claude/rules" 2>/dev/null | wc -l | tr -d ' ')"
check "five files written" "$([ "$n" = 5 ] && echo ok || echo "got $n")"
marked=0
for f in "$tmp/.claude/rules"/*.md; do
  grep -q "Generated by claude-org-setup" "$f" && marked=$((marked + 1))
done
check "every file carries the marker" "$([ "$marked" = "$n" ] && echo ok || echo "$marked of $n")"

# 2. Frontmatter stays first in the path-scoped conventions file.
first="$(head -1 "$tmp/.claude/rules/org-conventions.md")"
check "conventions frontmatter opens the file" "$([ "$first" = '---' ] && echo ok || echo "first line: $first")"
check "conventions keeps its paths scope" "$(grep -q '\*\*/\*\.org' "$tmp/.claude/rules/org-conventions.md" && echo ok || echo missing)"

# 3. Always-loaded machinery file has no frontmatter, marker at top.
first="$(head -1 "$tmp/.claude/rules/org-event-queue.md")"
check "machinery file opens with the marker comment" "$(printf '%s' "$first" | grep -q '^<!--' && echo ok || echo "first line: $first")"

# 4. Re-run is idempotent: same bytes.
before="$(cat "$tmp/.claude/rules/org-state-transitions.md")"
"$setup" "$tmp" >/dev/null 2>&1
after="$(cat "$tmp/.claude/rules/org-state-transitions.md")"
check "re-run leaves identical content" "$([ "$before" = "$after" ] && echo ok || echo differs)"

# 5. An unmarked existing file refuses without --force...
echo "hand-maintained" > "$tmp/.claude/rules/org-mcp-tools.md"
out="$("$setup" "$tmp" 2>&1)"; rc=$?
check "unmarked file refuses" "$([ $rc -ne 0 ] && echo ok || echo "exited 0")"
check "refusal names the file" "$(printf '%s' "$out" | grep -q 'org-mcp-tools.md' && echo ok || echo "output: $out")"
check "refusal left the file alone" "$([ "$(cat "$tmp/.claude/rules/org-mcp-tools.md")" = "hand-maintained" ] && echo ok || echo clobbered)"

# 6. ...and yields to --force.
out="$("$setup" --force "$tmp" 2>&1)"; rc=$?
check "--force exits 0" "$([ $rc -eq 0 ] && echo ok || echo "rc=$rc")"
check "--force replaced the file" "$(grep -q "Generated by claude-org-setup" "$tmp/.claude/rules/org-mcp-tools.md" && echo ok || echo "still hand copy")"

# 7. A bad flag is an error, not a directory.
out="$("$setup" --frce "$tmp" 2>&1)"; rc=$?
check "unknown flag exits 2" "$([ $rc -eq 2 ] && echo ok || echo "rc=$rc")"

echo "Ran $checks checks, $fails failure(s)"
exit "$([ "$fails" -eq 0 ] && echo 0 || echo 1)"
