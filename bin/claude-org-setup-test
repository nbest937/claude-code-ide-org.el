#!/usr/bin/env bash
# Prove bin/claude-org-setup's behaviour against a temp target:
# promotion writes every file with the marker, frontmatter stays first
# where the reference has one, an unmarked existing file refuses without
# --force and yields to it, and a re-run is idempotent. Runs the real
# script against the real references — the point is the promotion
# mechanics, not fixture content.

set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
setup="$script_dir/claude-org-setup"

checks=0
fails=0
check() { # label verdict
  checks=$((checks + 1))
  if [ "$2" = ok ]; then
    echo "ok   $1"
  else
    fails=$((fails + 1))
    echo "FAIL $1: $2"
  fi
}

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# 1. Fresh promotion writes all five files, each carrying the marker.
out="$("$setup" "$tmp" 2>&1)"; rc=$?
check "fresh run exits 0" "$([ $rc -eq 0 ] && echo ok || echo "rc=$rc: $out")"
n="$(ls "$tmp/.claude/rules" 2>/dev/null | wc -l | tr -d ' ')"
check "five files written" "$([ "$n" = 5 ] && echo ok || echo "got $n")"
marked=0
for f in "$tmp/.claude/rules"/*.md; do
  grep -q "Generated by claude-org-setup" "$f" && marked=$((marked + 1))
done
check "every file carries the marker" "$([ "$marked" = "$n" ] && echo ok || echo "$marked of $n")"

# 2. Frontmatter stays first in the path-scoped conventions file.
first="$(head -1 "$tmp/.claude/rules/org-conventions.md")"
check "conventions frontmatter opens the file" "$([ "$first" = '---' ] && echo ok || echo "first line: $first")"
check "conventions keeps its paths scope" "$(grep -q '\*\*/\*\.org' "$tmp/.claude/rules/org-conventions.md" && echo ok || echo missing)"

# 3. Always-loaded machinery file has no frontmatter, marker at top.
first="$(head -1 "$tmp/.claude/rules/org-event-queue.md")"
check "machinery file opens with the marker comment" "$(printf '%s' "$first" | grep -q '^<!--' && echo ok || echo "first line: $first")"

# 4. Re-run is idempotent: same bytes.
before="$(cat "$tmp/.claude/rules/org-state-transitions.md")"
"$setup" "$tmp" >/dev/null 2>&1
after="$(cat "$tmp/.claude/rules/org-state-transitions.md")"
check "re-run leaves identical content" "$([ "$before" = "$after" ] && echo ok || echo differs)"

# 5. An unmarked existing file refuses without --force...
echo "hand-maintained" > "$tmp/.claude/rules/org-mcp-tools.md"
out="$("$setup" "$tmp" 2>&1)"; rc=$?
check "unmarked file refuses" "$([ $rc -ne 0 ] && echo ok || echo "exited 0")"
check "refusal names the file" "$(printf '%s' "$out" | grep -q 'org-mcp-tools.md' && echo ok || echo "output: $out")"
check "refusal left the file alone" "$([ "$(cat "$tmp/.claude/rules/org-mcp-tools.md")" = "hand-maintained" ] && echo ok || echo clobbered)"

# 6. ...and yields to --force.
out="$("$setup" --force "$tmp" 2>&1)"; rc=$?
check "--force exits 0" "$([ $rc -eq 0 ] && echo ok || echo "rc=$rc")"
check "--force replaced the file" "$(grep -q "Generated by claude-org-setup" "$tmp/.claude/rules/org-mcp-tools.md" && echo ok || echo "still hand copy")"

# 7. A bad flag is an error, not a directory.
out="$("$setup" --frce "$tmp" 2>&1)"; rc=$?
check "unknown flag exits 2" "$([ $rc -eq 2 ] && echo ok || echo "rc=$rc")"

# 8. --check: clean copies pass, a drifted copy fails and is named, a
#    missing copy fails, and nothing is written by any of it.
"$setup" --force "$tmp" >/dev/null 2>&1
out="$("$setup" --check "$tmp" 2>&1)"; rc=$?
check "--check passes on fresh copies" "$([ $rc -eq 0 ] && echo ok || echo "rc=$rc: $out")"

echo "drift" >> "$tmp/.claude/rules/org-event-queue.md"
before="$(cat "$tmp/.claude/rules/org-event-queue.md")"
out="$("$setup" --check "$tmp" 2>&1)"; rc=$?
check "--check fails on a drifted copy" "$([ $rc -eq 1 ] && echo ok || echo "rc=$rc")"
check "--check names the drifted file" "$(printf '%s' "$out" | grep -q 'drifted: .*org-event-queue.md' && echo ok || echo "output: $out")"
after="$(cat "$tmp/.claude/rules/org-event-queue.md")"
check "--check wrote nothing" "$([ "$before" = "$after" ] && echo ok || echo rewrote)"

rm "$tmp/.claude/rules/org-session-tracking.md"
out="$("$setup" --check "$tmp" 2>&1)"; rc=$?
check "--check fails on a missing copy" "$([ $rc -eq 1 ] && printf '%s' "$out" | grep -q 'missing: .*org-session-tracking.md' && echo ok || echo "rc=$rc: $out")"

# 9. --doom: prints both init.el lines from a git checkout, writes
#    nothing, and refuses from an update-managed (non-git) copy with
#    the clone instruction.
out="$("$setup" --doom 2>&1)"; rc=$?
check "--doom exits 0 from the checkout" "$([ $rc -eq 0 ] && echo ok || echo "rc=$rc: $out")"
check "--doom prints the load-path line" "$(printf '%s' "$out" | grep -q "doom-module-load-path \"$script_dir/../modules\"\|doom-module-load-path .*/modules" && echo ok || echo "output: $out")"
check "--doom prints the module flag" "$(printf '%s' "$out" | grep -q 'claude-code-ide-org' && echo ok || echo missing)"

managed="$(mktemp -d)"
mkdir -p "$managed/bin"
cp "$setup" "$managed/bin/claude-org-setup"
out="$("$managed/bin/claude-org-setup" --doom 2>&1)"; rc=$?
check "--doom refuses a non-git plugin copy" "$([ $rc -eq 1 ] && echo ok || echo "rc=$rc")"
check "the refusal says to clone" "$(printf '%s' "$out" | grep -q 'clone the repo' && echo ok || echo "output: $out")"
rm -rf "$managed"

# 10. --org: scaffolds both files from the templates, reports and
#     never touches an existing file, prints the three follow-ups.
orgdir="$(mktemp -d)"
out="$("$setup" --org "$orgdir" 2>&1)"; rc=$?
check "--org exits 0 in an empty dir" "$([ $rc -eq 0 ] && echo ok || echo "rc=$rc: $out")"
check "--org created TODO.org with the header" "$(head -1 "$orgdir/TODO.org" 2>/dev/null | grep -q '^#+TODO:' && echo ok || echo missing)"
check "--org created DONE.org" "$([ -f "$orgdir/DONE.org" ] && echo ok || echo missing)"
check "--org prints the symlink follow-up" "$(printf '%s' "$out" | grep -q 'ln -s' && echo ok || echo missing)"
check "--org prints the restart note" "$(printf '%s' "$out" | grep -qi 'RESTART' && echo ok || echo missing)"
check "--org prints the standalone-projects addition" "$(printf '%s' "$out" | grep -q 'standalone-projects' && echo ok || echo missing)"

echo "custom content" > "$orgdir/TODO.org"
out="$("$setup" --org "$orgdir" 2>&1)"; rc=$?
check "--org leaves an existing file untouched" "$([ "$(cat "$orgdir/TODO.org")" = "custom content" ] && echo ok || echo clobbered)"
check "--org reports the collision" "$(printf '%s' "$out" | grep -q 'exists:.*TODO.org' && echo ok || echo "output: $out")"
check "--org still exits 0 on collision" "$([ $rc -eq 0 ] && echo ok || echo "rc=$rc")"
rm -rf "$orgdir"

# 11. --glue: writes the deferring glue into $DOOMDIR, prints the one
#     stub, honours the clobber contract, refuses a missing DOOMDIR.
gluedir="$(mktemp -d)"
out="$(DOOMDIR="$gluedir" "$setup" --glue 2>&1)"; rc=$?
gluefile="$gluedir/claude-code-ide-org-glue.el"
check "--glue exits 0" "$([ $rc -eq 0 ] && echo ok || echo "rc=$rc: $out")"
check "--glue wrote the marked file" "$(grep -q 'Generated by claude-org-setup' "$gluefile" 2>/dev/null && echo ok || echo missing)"
check "the glue self-defers" "$(grep -q 'with-eval-after-load' "$gluefile" && echo ok || echo missing)"
check "the glue enables the machinery" "$(grep -q 'claude-code-ide-emacs-tools-setup' "$gluefile" && echo ok || echo missing)"
check "the glue derives its projects" "$(grep -q "'derive" "$gluefile" && echo ok || echo missing)"
check "--glue prints the load! stub" "$(printf '%s' "$out" | grep -q 'load! "claude-code-ide-org-glue"' && echo ok || echo "output: $out")"
before="$(cat "$gluefile")"
DOOMDIR="$gluedir" "$setup" --glue >/dev/null 2>&1
check "--glue re-run is idempotent" "$([ "$(cat "$gluefile")" = "$before" ] && echo ok || echo differs)"
echo "hand-maintained" > "$gluefile"
out="$(DOOMDIR="$gluedir" "$setup" --glue 2>&1)"; rc=$?
check "--glue refuses an unmarked file" "$([ $rc -ne 0 ] && [ "$(cat "$gluefile")" = "hand-maintained" ] && echo ok || echo "rc=$rc")"
out="$(DOOMDIR="$gluedir" "$setup" --glue --force 2>&1)"; rc=$?
check "--glue --force replaces it" "$([ $rc -eq 0 ] && grep -q 'Generated by' "$gluefile" && echo ok || echo "rc=$rc")"
out="$(DOOMDIR="$gluedir/nope" "$setup" --glue 2>&1)"; rc=$?
check "--glue refuses a missing DOOMDIR" "$([ $rc -eq 1 ] && printf '%s' "$out" | grep -q 'no Doom config dir' && echo ok || echo "rc=$rc")"
rm -rf "$gluedir"

echo "Ran $checks checks, $fails failure(s)"
exit "$([ "$fails" -eq 0 ] && echo 0 || echo 1)"
