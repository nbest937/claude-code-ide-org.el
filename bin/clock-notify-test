#!/usr/bin/env bash
# Shell test harness for bin/clock-notify's decision logic.
#
# This is a "documented manual verification pass" in the sense CLAUDE.md's
# testing rule allows: bin/clock-notify's own branching logic (extracting
# the tool's return string, matching the tool name, comparing against the
# emacsclient cross-check, deciding match vs. mismatch) is fully mechanical
# and testable here with stubbed emacsclient/osascript on PATH. What is
# NOT testable from an isolated worktree -- and is not claimed as tested by
# this harness -- is (1) the real shape of a PostToolUse payload's
# tool_response field for an actual MCP tool call, (2) a real emacsclient
# round-trip to a live Emacs/org buffer, and (3) a real osascript
# notification actually appearing on screen tied to a real clock event.
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
script="$repo_root/bin/clock-notify"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

fail=0

# --- stub emacsclient -------------------------------------------------
# Controlled by $STUB_CLOCKING_P ("t", "nil", or "UNREACHABLE").
cat >"$work/emacsclient" <<'EOF'
#!/usr/bin/env bash
if [[ "${STUB_CLOCKING_P:-nil}" == "UNREACHABLE" ]]; then
  echo "emacsclient: can't find socket" >&2
  exit 1
fi
echo "$STUB_CLOCKING_P"
EOF
chmod +x "$work/emacsclient"

# --- stub osascript ----------------------------------------------------
# Records the notification title/body it was asked to display.
cat >"$work/osascript" <<EOF
#!/usr/bin/env bash
# Args: -e '<applescript>' "\$title" "\$body"
echo "TITLE:\${@: -2:1}" >> "$work/notifications.log"
echo "BODY:\${@: -1}" >> "$work/notifications.log"
exit 0
EOF
chmod +x "$work/osascript"

run_case() {
  local name="$1" clocking="$2" payload="$3"
  : >"$work/notifications.log"
  STUB_CLOCKING_P="$clocking" PATH="$work:$PATH" bash "$script" <<<"$payload"
  echo "=== $name ==="
  cat "$work/notifications.log" 2>/dev/null || echo "(no notification fired)"
  echo
}

expect_contains() {
  local name="$1" needle="$2"
  if grep -qF "$needle" "$work/notifications.log" 2>/dev/null; then
    echo "ok   - $name"
  else
    echo "FAIL - $name: expected to find '$needle' in notification log"
    cat "$work/notifications.log" 2>/dev/null
    fail=1
  fi
}

expect_no_notification() {
  local name="$1"
  if [[ -s "$work/notifications.log" ]]; then
    echo "FAIL - $name: expected no notification, got:"
    cat "$work/notifications.log"
    fail=1
  else
    echo "ok   - $name"
  fi
}

# 1. clock-in success, emacsclient confirms clocking -> match
run_case "clock-in match" "t" '{
  "tool_name": "mcp__emacs-tools__org_clock_in",
  "tool_response": {"text": "Clocked in: \"Write the report\""}
}'
grep -q "MISMATCH" "$work/notifications.log" && { echo "FAIL - clock-in match: unexpected MISMATCH"; fail=1; } || echo "ok   - clock-in match: no MISMATCH"
expect_contains "clock-in match: body shows verified clocking=true" "verified: clocking=true"

# 2. clock-in success claimed, but emacsclient says nil -> MISMATCH
run_case "clock-in mismatch" "nil" '{
  "tool_name": "mcp__emacs-tools__org_clock_in",
  "tool_response": {"text": "Clocked in: \"Write the report\""}
}'
expect_contains "clock-in mismatch: title flags MISMATCH" "TITLE:org clock MISMATCH (clock-in)"

# 3. clock-out success, emacsclient confirms not clocking -> match
run_case "clock-out match" "nil" '{
  "tool_name": "mcp__emacs-tools__org_clock_out",
  "tool_response": {"text": "Clocked out: \"Write the report\""}
}'
grep -q "MISMATCH" "$work/notifications.log" && { echo "FAIL - clock-out match: unexpected MISMATCH"; fail=1; } || echo "ok   - clock-out match: no MISMATCH"
expect_contains "clock-out match: body shows verified clocking=false" "verified: clocking=false"

# 4. clock-out success claimed, but emacsclient says t (still clocking) -> MISMATCH
run_case "clock-out mismatch" "t" '{
  "tool_name": "mcp__emacs-tools__org_clock_out",
  "tool_response": {"text": "Clocked out: \"Write the report\""}
}'
expect_contains "clock-out mismatch: title flags MISMATCH" "TITLE:org clock MISMATCH (clock-out)"

# 5. clock-out noop (no clock was running), emacsclient agrees -> match, no MISMATCH
run_case "clock-out noop match" "nil" '{
  "tool_name": "mcp__emacs-tools__org_clock_out",
  "tool_response": {"text": "No clock is currently running."}
}'
grep -q "MISMATCH" "$work/notifications.log" && { echo "FAIL - clock-out noop: unexpected MISMATCH"; fail=1; } || echo "ok   - clock-out noop: no MISMATCH"

# 6. tool claims error -> relayed as-is, no mismatch computed (tool already admits failure)
run_case "clock-out tool-reported error" "nil" '{
  "tool_name": "mcp__emacs-tools__org_clock_out",
  "tool_response": {"text": "Error: heading not found"}
}'
grep -q "MISMATCH" "$work/notifications.log" && { echo "FAIL - error case: unexpected MISMATCH"; fail=1; } || echo "ok   - error case: no MISMATCH computed"
expect_contains "error case: body relays the error text" "Error: heading not found"

# 7. emacsclient unreachable -> notes it, does not claim verification, no MISMATCH
run_case "emacsclient unreachable" "UNREACHABLE" '{
  "tool_name": "mcp__emacs-tools__org_clock_in",
  "tool_response": {"text": "Clocked in: \"Write the report\""}
}'
expect_contains "unreachable: body says so" "Emacs unreachable"
grep -q "MISMATCH" "$work/notifications.log" && { echo "FAIL - unreachable: unexpected MISMATCH"; fail=1; } || echo "ok   - unreachable: no MISMATCH"

# 8. non-clock tool_name -> hook is a no-op, no notification at all
run_case "unrelated tool ignored" "nil" '{
  "tool_name": "mcp__emacs-tools__org_set_todo",
  "tool_response": {"text": "Set to DOING"}
}'
expect_no_notification "unrelated tool: no notification fired"

# 9. alternate tool_response shape: content[0].text (MCP content-block style)
run_case "content-array response shape" "t" '{
  "tool_name": "mcp__emacs-tools__org_clock_in",
  "tool_response": {"content": [{"type": "text", "text": "Clocked in: \"Write the report\""}]}
}'
expect_contains "content-array shape: extracted text used, no MISMATCH" "verified: clocking=true"

# 10. alternate tool_response shape: bare string
run_case "bare-string response shape" "t" '{
  "tool_name": "mcp__emacs-tools__org_clock_in",
  "tool_response": "Clocked in: \"Write the report\""
}'
expect_contains "bare-string shape: extracted text used" "verified: clocking=true"

if [[ $fail -eq 0 ]]; then
  echo
  echo "All bin/clock-notify decision-logic cases passed (mocked emacsclient/osascript)."
else
  echo
  echo "One or more bin/clock-notify test cases FAILED."
fi
exit $fail
