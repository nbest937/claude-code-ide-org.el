#!/usr/bin/env bash
# Shell test harness for bin/hooks/conventions-inject. Same register as
# bin/queue-append-test: fixtures in, positive assertions out.
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
hook="$repo_root/bin/hooks/conventions-inject"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
export CLAUDE_ORG_QUEUE_DIR="$tmp/queue"

failures=0
check() {
  local what="$1" want="$2" got="$3"
  if [[ "$want" == "$got" ]]; then echo "ok   - $what"
  else echo "FAIL - $what: wanted [$want], got [$got]"; failures=$((failures + 1)); fi
}

proj="$tmp/proj"
mkdir -p "$proj/.claude/rules"
printf '%s\n' '---' 'paths: ["**/*.org"]' '---' '# Org-file conventions' 'prose' \
  '## Slices' 'more prose' '### Closing a slice' '```' '## not a heading, a fence' '```' \
  > "$proj/.claude/rules/org-conventions.md"
export CLAUDE_PROJECT_DIR="$proj"

payload() { printf '{"session_id":"%s","hook_event_name":"PostToolUse","tool_name":"mcp__emacs-tools__org_outline"%s}' "$1" "${2:-}"; }
ctx() { jq -r '.hookSpecificOutput.additionalContext // empty' <<<"$1"; }

out="$(payload s1 | "$hook")"
check "the first org call injects" "PostToolUse" "$(jq -r '.hookSpecificOutput.hookEventName' <<<"$out")"
check "it names the file to Read" "yes" "$(ctx "$out" | grep -qF "$proj/.claude/rules/org-conventions.md" && echo yes || echo no)"
check "it lists the file's own sections" "yes" "$(ctx "$out" | grep -q 'Slices' && ctx "$out" | grep -q 'Closing a slice' && echo yes || echo no)"
check "a fenced line is not a section" "no" "$(ctx "$out" | grep -q 'not a heading' && echo yes || echo no)"
check "it says why: the tools never trigger the path scope" "yes" "$(ctx "$out" | grep -qi 'Read tool' && echo yes || echo no)"
check "it stays under the 10,000-character cap" "yes" "$([[ "$(ctx "$out" | wc -c)" -lt 10000 ]] && echo yes || echo no)"

check "the second call in the session is silent" "" "$(payload s1 | "$hook")"
check "another session gets its own" "yes" "$([[ -n "$(payload s2 | "$hook")" ]] && echo yes || echo no)"
check "a subagent has its own context, so its own injection" "yes" \
  "$([[ -n "$(payload s1 ',"agent_id":"agent-7"' | "$hook")" ]] && echo yes || echo no)"
check "and only one" "" "$(payload s1 ',"agent_id":"agent-7"' | "$hook")"

# The local additions ride along when the repo has them.
printf '%s\n' '# Local' '## Level-1 history' > "$proj/.claude/rules/org-conventions-local.md"
out="$(payload s3 | "$hook")"
check "local additions are named too" "yes" "$(ctx "$out" | grep -qF 'org-conventions-local.md' && echo yes || echo no)"

# Unpromoted consumer: fall back to the plugin's shipped reference.
bare="$tmp/bare"; mkdir -p "$bare"
out="$(payload s4 | CLAUDE_PROJECT_DIR="$bare" "$hook")"
check "with nothing promoted it names the shipped reference" "yes" \
  "$(ctx "$out" | grep -qF "skills/org/references/org-conventions.md" && echo yes || echo no)"

check "a traversing session_id is refused" "" "$(payload ../x | "$hook")"
check "and wrote nothing outside the queue" "no" "$([[ -e "$tmp/x.conventions-seen" ]] && echo yes || echo no)"
printf 'garbage' | "$hook" >/dev/null 2>&1
check "always exits 0" "0" "$?"

echo
if [[ $failures -eq 0 ]]; then echo "conventions-inject-test: all checks passed"
else echo "conventions-inject-test: $failures check(s) failed"; fi
exit $((failures > 0))
