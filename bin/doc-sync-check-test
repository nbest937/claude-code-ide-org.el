#!/usr/bin/env bash
# Prove bin/hooks/doc-sync-check fires on exactly the two documents it
# guards, and stays silent otherwise. Same register as
# bin/queue-append-test: fixtures in, positive assertions out.
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
hook="$repo_root/bin/hooks/doc-sync-check"
fail=0

check() {
  local desc="$1" want="$2" got="$3"
  if [ "$got" = "$want" ]; then echo "ok   - $desc"
  else echo "FAIL - $desc"; echo "       want: $want"; echo "       got:  $got"; fail=1; fi
}

run() { # run <file_path payload value>
  printf '{"tool_name":"Edit","tool_input":{"file_path":"%s"}}' "$1" \
    | env CLAUDE_PROJECT_DIR=/proj bash "$hook"
}

# 1. Editing the project CLAUDE.md points at README.md, on both channels.
out="$(run /proj/CLAUDE.md)"
check "CLAUDE.md edit emits JSON" "0" "$(jq -e . >/dev/null 2>&1 <<<"$out"; echo $?)"
check "context names the sibling README.md" "README.md" "$(jq -r '.hookSpecificOutput.additionalContext' <<<"$out" | grep -o 'README.md' | head -1)"
check "event name is PostToolUse" "PostToolUse" "$(jq -r '.hookSpecificOutput.hookEventName' <<<"$out")"
check "systemMessage present for the human" "0" "$(jq -e '.systemMessage | length > 0' >/dev/null 2>&1 <<<"$out"; echo $?)"

# 2. Editing README.md points back at CLAUDE.md.
out="$(run /proj/README.md)"
check "README.md edit names CLAUDE.md" "CLAUDE.md" "$(jq -r '.hookSpecificOutput.additionalContext' <<<"$out" | grep -o 'CLAUDE.md' | head -1)"

# 3. Any other file: silence.
check "another file emits nothing" "" "$(run /proj/TODO.org)"

# 4. A CLAUDE.md that is NOT the project's (the user-global one): silence.
#    Basename matching would fire here; the guard is the full path.
check "a foreign CLAUDE.md emits nothing" "" "$(run /home/u/.claude/CLAUDE.md)"

# 5. Garbage stdin: silence, exit 0.
out="$(printf 'not json' | env CLAUDE_PROJECT_DIR=/proj bash "$hook")"; rc=$?
check "garbage stdin is silent" "" "$out"
check "garbage stdin exits 0" "0" "$rc"

if [ "$fail" -eq 0 ]; then echo; echo "All doc-sync-check tests passed."
else echo; echo "Some doc-sync-check tests FAILED."; fi
exit "$fail"
