#!/usr/bin/env bash
# Shell test harness for bin/hooks/exitplanmode-promote-planning.
#
# This script had no automated coverage before the 2026-08-11 cutover
# (TODO.org :ID: feba67eb-35b3-48bd-a892-8ecd47ca52e0), and could not
# reasonably have had any: it was a here-doc of elisp handed to
# `emacsclient -e`, so testing it meant testing a running Emacs. It is
# now a bash read of one queue file, which is exactly the shape a shell
# harness can pin.
#
# Fully covered here: which heading gets promoted and when, the no-op
# cases, tolerance of a torn line, and that it never fails its caller.
# NOT covered, and not claimed to be: the real shape of a live
# ExitPlanMode PostToolUse payload, and the approved-vs-rejected
# distinction, which is a known accepted gap rather than a testable
# behavior (see the script's own header).

set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
script="$repo_root/bin/hooks/exitplanmode-promote-planning"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

fail=0

export CLAUDE_ORG_QUEUE_DIR="$work/queue"

reset_queue() { rm -rf "$CLAUDE_ORG_QUEUE_DIR"; mkdir -p "$CLAUDE_ORG_QUEUE_DIR"; }

# seed SESSION LINE... -- write raw lines into a session's queue file.
seed() {
  local session="$1"; shift
  printf '%s\n' "$@" >> "$CLAUDE_ORG_QUEUE_DIR/$session.jsonl"
}

# todo_line ID STATE -- one well-formed todo event.
todo_line() {
  printf '{"ts":"2026-08-11T12:00:00-0500","kind":"todo","id":"%s","state":"%s","from":null,"session_id":"sess-a","source":"mcp__emacs-tools__org_set_todo"}' "$1" "$2"
}

run() {
  printf '%s' "${1:-{\"session_id\":\"sess-a\"\}}" | "$script"
}

queue_lines() { cat "$CLAUDE_ORG_QUEUE_DIR/$1.jsonl" 2>/dev/null; }

check() {
  local label="$1" expected="$2" actual="$3"
  if [[ "$expected" == "$actual" ]]; then
    echo "ok   - $label"
  else
    echo "FAIL - $label"
    echo "         expected: $expected"
    echo "         actual:   $actual"
    fail=1
  fi
}

# --- promotes the heading this session most recently set PLANNING ------
reset_queue
seed sess-a "$(todo_line id-a PLANNING)"
run '{"session_id":"sess-a"}'
last="$(queue_lines sess-a | tail -1)"
check "appends a todo event" "todo" "$(jq -r '.kind' <<<"$last")"
check "promotes the PLANNING heading" "id-a" "$(jq -r '.id' <<<"$last")"
check "queues DOING" "DOING" "$(jq -r '.state' <<<"$last")"
check "records from PLANNING" "PLANNING" "$(jq -r '.from' <<<"$last")"
check "leaves the original event alone" "2" "$(queue_lines sess-a | wc -l | tr -d ' ')"

# --- the MOST RECENT todo decides, not the first -----------------------
reset_queue
seed sess-a "$(todo_line id-a PLANNING)" "$(todo_line id-b PLANNING)"
run '{"session_id":"sess-a"}'
check "latest PLANNING wins" "id-b" "$(jq -r '.id' <<<"$(queue_lines sess-a | tail -1)")"

# --- no-op when the session has moved past PLANNING --------------------
reset_queue
seed sess-a "$(todo_line id-a PLANNING)" "$(todo_line id-a DOING)"
run '{"session_id":"sess-a"}'
check "already promoted is a no-op" "2" "$(queue_lines sess-a | wc -l | tr -d ' ')"

# --- no-op when this session never set PLANNING ------------------------
# The COMMON case: the user entered Plan Mode by hand, so no org_set_todo
# ever ran and there is nothing to promote.
reset_queue
seed sess-a "$(todo_line id-a NEXT)"
run '{"session_id":"sess-a"}'
check "non-PLANNING latest is a no-op" "1" "$(queue_lines sess-a | wc -l | tr -d ' ')"

# --- another session's PLANNING is invisible ---------------------------
# The cross-session guard, which is now structural rather than a check:
# the file is per-session, so there is nothing to guard against.
reset_queue
seed sess-b "$(todo_line id-b PLANNING)"
run '{"session_id":"sess-a"}'
check "does not promote another session's heading" "" "$(queue_lines sess-a)"
check "does not touch the other session's file" "1" \
  "$(queue_lines sess-b | wc -l | tr -d ' ')"

# --- degenerate inputs -------------------------------------------------
reset_queue
run '{"session_id":"sess-a"}'
check "missing queue file writes nothing" "" "$(queue_lines sess-a)"

reset_queue
seed sess-a "$(todo_line id-a PLANNING)"
run '{"hook_event_name":"PostToolUse"}'
check "missing session_id writes nothing" "1" "$(queue_lines sess-a | wc -l | tr -d ' ')"

reset_queue
seed sess-a "$(todo_line id-a PLANNING)"
run '{"session_id":"../../etc/passwd"}'
check "path-like session_id is refused" "1" "$(queue_lines sess-a | wc -l | tr -d ' ')"

# --- a torn line costs that line, not the read -------------------------
reset_queue
seed sess-a "$(todo_line id-a PLANNING)" '{"kind":"todo","id":"trunc'
run '{"session_id":"sess-a"}'
check "torn trailing line does not block the promotion" "id-a" \
  "$(jq -R -r 'fromjson? | select(.state == "DOING") | .id' \
      "$CLAUDE_ORG_QUEUE_DIR/sess-a.jsonl" 2>/dev/null)"

# --- never fails its caller --------------------------------------------
printf '%s' 'garbage' | "$script" >/dev/null 2>&1
check "always exits 0" "0" "$?"

echo
if [[ $fail -eq 0 ]]; then
  echo "All exitplanmode-promote tests passed."
else
  echo "Some exitplanmode-promote tests FAILED."
fi
exit $fail
