#!/usr/bin/env bash
# Tests for bin/hooks/footnote-check (TODO.org :ID: 2758f3a0).
#
# Shell, not ERT: the thing under test is a shell script reading a JSON
# payload, and testing it through its real interface is the only way to
# catch a jq or awk mistake. Always prints a result -- silence is not a
# passing check.

set -uo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
hook="$repo/bin/hooks/footnote-check"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
export CLAUDE_ORG_QUEUE_DIR="$tmp"
export CLAUDE_PROJECT_DIR="$repo"

pass=0; fail=0
# A real tracked id, and a real one used as the "already footnoted" case.
REAL="$(grep -ohE '^:ID: +[0-9a-f]{8}' "$repo/TODO.org" | head -1 | awk '{print $2}')"
REAL2="$(grep -ohE '^:ID: +[0-9a-f]{8}' "$repo/TODO.org" | sed -n '2p' | awk '{print $2}')"
# A tracked id whose 8-char prefix is ALL DIGITS. Derived rather than
# written down so it cannot rot, and the tests using it skip loudly if
# the corpus ever has none -- a vacuous pass here would hide exactly the
# defect these cases exist for.
REALNUM="$(grep -ohE '^:ID: +[0-9]{8}' "$repo/TODO.org" "$repo/DONE.org" | head -1 | awk '{print $2}')"

# Blocking is signalled by EXIT CODE 2 with the message on stderr, not
# by JSON (TODO.org :ID: 5787bfc6). A hook that exits 0 has its stderr
# sent to the debug log only -- "Claude never sees it" -- so the earlier
# JSON forms blocked the turn while saying nothing. `run' therefore
# captures stderr and the status, and discards stdout, which is empty.
# `run' is always used inside $(...), which is a SUBSHELL -- so it
# cannot set a variable the caller reads. The exit status therefore
# travels as the first line of its own output. Losing that costs four
# silent "allowed" results on tests that should block, which is exactly
# what happened on the first attempt.
run () { # run <session> <message> -> "<rc>\n<stderr>"
  local out rc
  out="$(jq -n --arg s "$1" --arg m "$2" \
    '{session_id:$s, last_assistant_message:$m}' | "$hook" 2>&1 >/dev/null)"
  rc=$?
  printf '%d\n%s' "$rc" "$out"
}
rc_of () { printf '%s' "${1%%$'\n'*}"; }          # first line
msg_of () { printf '%s' "${1#*$'\n'}"; }           # the rest
check () { # check <name> <expect blocked|allowed> <output>
  local name="$1" want="$2" out="$3" got
  if [[ "$(rc_of "$out")" -eq 2 ]]; then got=blocked; else got=allowed; fi
  if [[ "$got" == "$want" ]]; then
    printf 'ok   - %s (%s)\n' "$name" "$got"; pass=$((pass+1))
  else
    printf 'FAIL - %s: wanted %s, got %s\n' "$name" "$want" "$got"; fail=$((fail+1))
  fi
}

check "cited id with no footnote block blocks" blocked \
  "$(run s1 "See ${REAL} for the detail.")"

check "cited id with a footnote passes" allowed \
  "$(run s2 "See ${REAL}¹ for the detail.

---

¹ \`${REAL}\` — TODO *Some exact title*")"

check "one footnoted, one not, still blocks" blocked \
  "$(run s3 "Both ${REAL} and ${REAL2} matter.

---

¹ \`${REAL}\` — TODO *Some exact title*")"

check "an 8-hex token that is not a tracked :ID: is ignored" allowed \
  "$(run s4 "Commit deadbeef fixed it.")"

# Renamed 2026-08-26. This used to be called "an 8-digit number is not
# an id", which is what the hook's own all-digit filter asserted -- and
# that filter was the defect (5 tracked ids are all digits). The case
# still passes and is still worth keeping, but for the opposite reason:
# the :ID: LOOKUP rejects it, exactly as it rejects a git short hash.
check "an 8-digit number that is not a tracked :ID: is ignored" allowed \
  "$(run s5 "There were 20260824 events.")"

check "a message citing nothing passes" allowed \
  "$(run s6 "No identifiers here at all.")"

# Fenced code blocks are transcripts, not citations (TODO.org :ID: 2758f3a0,
# amended 2026-08-26). A rendered slice checklist would otherwise demand a
# footnote per member, each restating a title visible in the block itself.
check "an id inside a fenced block is not a citation" allowed \
  "$(run s12 "Here is the checklist:

\`\`\`org
- [X] ${REAL} DONE something
\`\`\`
")"

check "an id inside a tilde fence is not a citation either" allowed \
  "$(run s13 "Output:

~~~
${REAL}
~~~
")"

# The exemption must be narrow: prose around a block is still scanned, and
# an INLINE backticked id is still a citation -- that is the normal way one
# gets written, and exempting it would gut the check.
check "prose after a fenced block is still scanned" blocked \
  "$(run s14 "Output:

\`\`\`
irrelevant
\`\`\`

See ${REAL} for the detail.")"

check "an inline backticked id is still a citation" blocked \
  "$(run s15 "See \`${REAL}\` for the detail.")"

# An all-digit tracked id must be enforced like any other. This is the
# defect the hook shipped with: it dropped all-digit tokens BEFORE the
# lookup, so 5 of 267 real ids could never be required. Found 2026-08-26
# when an unfootnoted 29439196 passed.
if [[ -n "$REALNUM" ]]; then
  check "an all-digit tracked :ID: with no footnote blocks" blocked \
    "$(run s9 "The ${REALNUM} decision is yours.")"

  check "an all-digit tracked :ID: with a footnote passes" allowed \
    "$(run s10 "The ${REALNUM}¹ decision is yours.

---

¹ \`${REALNUM}\` — TODO *Some exact title*")"

  # The worst shape, and the one that actually happened: a block that
  # reports a STRICT SUBSET of what is missing. It reads as
  # authoritative, so complying with it exactly still leaves the
  # response wrong -- the hook teaches the wrong lesson.
  out_mixed="$(run s11 "Both ${REALNUM} and ${REAL} matter.")"
  check "a mixed digit/hex citation blocks" blocked "$out_mixed"
  for want in "$REALNUM" "$REAL"; do
    if grep -q "$want" <<<"$(msg_of "$out_mixed")"; then
      printf 'ok   - the message names %s (yes)\n' "$want"; pass=$((pass+1))
    else
      printf 'FAIL - the message omits %s\n' "$want"; fail=$((fail+1))
    fi
  done
else
  printf 'SKIP - no all-digit tracked :ID: in the corpus; 4 cases not run\n'
fi

# The loop guard: the same session blocking twice must not block again.
out1="$(run s7 "See ${REAL} for the detail.")"
out2="$(run s7 "See ${REAL} for the detail.")"
check "first block sets the sentinel" blocked "$out1"
check "second call in the same turn does NOT block (loop guard)" allowed "$out2"

# The message must reach the model, which means STDERR plus exit 2.
# Asserted because blocking without saying why is the entire defect: six
# real blocks arrived as the bare harness default before the exit code
# turned out to be the cause (TODO.org :ID: 5787bfc6).
out="$(run s8 "See ${REAL} for the detail.")"
assert_txt () { # assert_txt <name> <pattern> <expect yes|no>
  local name="$1" pat="$2" want="$3" got=no
  grep -q "$pat" <<<"$(msg_of "$out")" && got=yes
  if [[ "$got" == "$want" ]]; then
    printf 'ok   - %s (%s)\n' "$name" "$got"; pass=$((pass+1))
  else
    printf 'FAIL - %s: wanted %s, got %s\n' "$name" "$want" "$got"; fail=$((fail+1))
  fi
}
assert_txt "the reason is on stderr" "without footnoting them" yes
assert_txt "and names the missing id" "$REAL" yes
assert_txt "no JSON is printed" "continue" no
if [[ "$(rc_of "$out")" -eq 2 ]]; then
  printf 'ok   - blocks with exit code 2 (2)\n'; pass=$((pass+1))
else
  printf 'FAIL - blocks with exit code 2: got %s\n' "$(rc_of "$out")"; fail=$((fail+1))
fi

printf 'footnote-check-test: %d passed, %d failed\n' "$pass" "$fail"
[[ $fail -eq 0 ]]
