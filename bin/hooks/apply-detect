#!/usr/bin/env bash
# UserPromptSubmit hook: tell the session when the review queue was
# applied since its last turn, so the human never has to announce
# "queue applied" (TODO.org :ID: 165ce65a).
#
# The signal already exists: the apply pass writes .applied watermark
# files in the queue directory. This script only READS them, keeping one
# stamp file per session whose mtime records the last time this session
# was told. Survive-without-Emacs tier, like the rest of the queue-append
# family: plain bash, jq for field mapping only, and every failure path
# exits 0 silently -- a context hook must never block a prompt.
#
# First prompt of a session initializes the stamp silently: history that
# predates the session belongs to SessionStart's report, not to this
# hook. After that, any watermark newer than the stamp means an apply
# happened between turns, and the session learns it as additionalContext
# riding the prompt it was going to read anyway -- same channel as the
# recovery report, at the natural turn boundary rather than as an
# interruption.
#
# Motivating incident for the "between turns" framing: on 2026-09-11 a
# commit's hook phase sat ~90 seconds against a live ceremony, because
# the session had no way to know an apply was in flight. Knowing applies
# happened is also a hint about when they do.
set -uo pipefail

queue_dir="${CLAUDE_ORG_QUEUE_DIR:-$HOME/.claude/org-updates}"
[ -d "$queue_dir" ] || exit 0

payload="$(cat 2>/dev/null || true)"
session_id="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)"
[ -n "$session_id" ] || exit 0

stamp="$queue_dir/$session_id.apply-seen"

# The mtime is a lie half the time (TODO.org :ID: 7b4f4f14): the apply
# pass rewrites a watermark on EVERY pass, including one that only
# dismissed events, so "the file moved" does not mean "something was
# applied". Each `applied' entry maps an event to the time of the pass
# that applied it, and a dismiss-only pass leaves those values alone --
# so the stamp is a RECORD, one line per watermark (name, TAB, its
# newest applied value), and an apply is a watermark whose newest value
# differs from the recorded one. Inequality rather than order, so the
# local offsets (-0500, -0600 across DST) never need parsing. The mtime
# test stays as the cheap first filter; jq runs only on files that moved.
newest_value() { # newest_value <watermark> -- its latest applied pass, or a
                 # marker that can never equal a recorded value when the
                 # file does not parse, so an unreadable file falls back to
                 # today's mtime judgement rather than silencing an apply.
  local v
  if v="$(jq -r '.applied | if type == "object" then ([.[] | strings] | max // "") else "" end' "$1" 2>/dev/null)"; then
    printf '%s' "$v"
  else
    printf 'unparseable@%s' "$(stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || date +%s)"
  fi
}

record_all() { # write every watermark's current value as the record, atomically
  local tmp
  tmp="$(mktemp "$queue_dir/.apply-seen.XXXXXX" 2>/dev/null)" || return 1
  # A header, so a record made when no watermark existed is never zero
  # bytes -- which is what a legacy stamp looks like, and would make the
  # next prompt re-initialise instead of report.
  printf '# apply-seen: watermark, TAB, newest applied pass time\n' > "$tmp"
  for f in "$queue_dir"/*.applied; do
    [ -e "$f" ] || continue
    printf '%s\t%s\n' "$(basename "$f")" "$(newest_value "$f")" >> "$tmp"
  done
  mv -f "$tmp" "$stamp" 2>/dev/null
}

# First prompt of a session, or a legacy empty stamp from before the
# record existed: record every value silently. Pre-session history is
# SessionStart's report, not this hook's.
if [ ! -s "$stamp" ]; then
  record_all
  exit 0
fi

changed=0
for f in "$queue_dir"/*.applied; do
  [ -e "$f" ] || continue
  [ "$f" -nt "$stamp" ] || continue
  name="$(basename "$f")"
  now="$(newest_value "$f")"
  # A watermark missing from the record counts as applied, so a session's
  # first apply is still reported.
  was="$(awk -F '\t' -v n="$name" '$1 == n { print substr($0, length(n) + 2); found = 1 } END { if (!found) print "\x01absent" }' "$stamp")"
  [ "$now" = "$was" ] || changed=$((changed + 1))
done

if [ "$changed" -eq 0 ]; then
  # Nothing applied; refresh the record so moved-but-unchanged files are
  # not re-read on every prompt. Nothing is owed, so advancing is safe.
  record_all
  exit 0
fi

context="The review queue was applied since this session's last turn \
($changed watermark(s) moved). The org record on disk is fresh: keywords \
and clocks reflect the apply, previously queued items may have landed, \
and TODO.org/DONE.org may carry an uncommitted diff awaiting a \
bookkeeping commit. Do not treat pre-apply staleness as current state, \
and do not re-queue events already applied."

# The record advances only once the report is actually on stdout, and the
# final exit is unconditional -- two halves of the same promise in the
# header, both of which this script broke until 2026-09-11.
#
# Emitting first is deliberate. If this hook is killed at its 10 s
# timeout, or jq fails for a reason its absence check at the top does not
# cover, the record stays put and the next prompt reports the same apply
# again. A duplicate report costs a sentence; advancing the record first
# meant a real apply was silently never reported at all, which is the
# failure the hook exists to prevent.
if jq -cn --arg ctx "$context" \
     '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext: $ctx}}'; then
  record_all
fi

exit 0
