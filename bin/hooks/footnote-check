#!/usr/bin/env bash
# Stop hook: refuse to end a turn whose response cites a tracked org
# :ID: without footnoting it.
#
# A STUB since 2026-09-25 (TODO.org :ID: c247d8f3). The scanning --
# which ids the segment cites, which resolve to a tracked heading,
# which the end matter or a same-line pairing already discharges --
# is `claude-code-ide-org-write-footnote-check' in config.el. This
# script keeps what must survive an Emacs outage and what decides
# whether to ask at all: the loop guard, the demand sentinel, the
# three-block bound, the miss count and the exit code.
#
# WHY IT MOVED. The hook read only `last_assistant_message', the turn's
# final text block, so an id cited in a block written before a tool call
# was never checked: 107 of 1,576 Stop segments across 60 transcripts,
# measured 2026-09-24. The earlier blocks are in `transcript_path', read
# through the same elisp reader the session render uses; the final block
# still comes from the payload, because the transcript is written
# asynchronously and may not hold it yet when Stop fires.
#
# AN OUTAGE OWES NOTHING (the user, 2026-09-24). Without Emacs no title
# can be looked up, so no footnote can be demanded: the hook exits 0
# silently. So does a call that takes longer than 3 s -- the watchdog
# below, since `emacsclient --timeout' bounds the connection and NOT
# the evaluation (measured 2026-09-25: `--timeout=2' waited out a 5 s
# `sleep-for'). The elisp always writes a first line, so an empty
# verdict file means the call never ran, never "nothing owed".
#
# LOOP GUARD, and it is not optional: the docs describe no
# `stop_hook_active' flag for a blocking Stop hook, so a hook that
# blocks on a condition the model then fails to satisfy blocks forever.
# A per-session sentinel, on the model of bin/hooks/block-start's,
# written when it blocks and cleared by bin/hooks/session-resume when the
# next prompt starts a new turn.
#
# CONTENT-AWARE since 2026-09-16 (TODO.org :ID: 45dc171f). The sentinel
# records the DEMAND -- the missing ids it asked about. An identical
# demand is never repeated, which is the anti-loop property: the hook can
# never ask twice for the same thing. A DIFFERENT demand blocks again,
# because the response right after a footnote block is the one rewriting
# footnote-heavy prose, where a new miss is likeliest. A hard bound of
# three blocks per turn stands behind that, so even a pathological
# alternation terminates.
#
# bash 3.2 throughout, which macOS still ships: no `mapfile', no
# associative arrays, no bare "${arr[@]}" on a possibly-empty array
# under `set -u' (TODO.org :ID: 7e9aa4ea).

set -uo pipefail

input="$(cat)"
command -v jq >/dev/null 2>&1 || exit 0

session_id="$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)"
[[ -n "$session_id" ]] || exit 0
case "$session_id" in
  *[!A-Za-z0-9._-]*|''|.|..) exit 0 ;;
esac

queue_dir="${CLAUDE_ORG_QUEUE_DIR:-$HOME/.claude/org-updates}"
sentinel="$queue_dir/$session_id.footnote-blocked"
# Prior demands this turn, one per line. Read rather than merely tested
# for existence -- see LOOP GUARD above.
prior=""
[[ -e "$sentinel" ]] && prior="$(cat "$sentinel" 2>/dev/null)"
# Hard bound, whatever the content: three asks in one turn is enough.
if [[ -n "$prior" ]] && [[ "$(grep -c . <<<"$prior")" -ge 3 ]]; then
  exit 0
fi

repo="${CLAUDE_PROJECT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

payload="$(mktemp)"
verdict="$(mktemp)"
trap 'rm -f "$payload" "$verdict"' EXIT
printf '%s' "$input" >"$payload"

# Paths reach elisp as escaped string literals, never through `getenv',
# which would read the SERVER's environment (measured 2026-09-18, see
# bin/hooks/session-start-recovery-check).
elisp_string() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
form="(claude-code-ide-org-write-footnote-check \"$(elisp_string "$payload")\" \"$(elisp_string "$verdict")\" \"$(elisp_string "$repo")\")"

# The watchdog's own streams go to /dev/null: a `sleep' left holding
# this hook's stderr would keep the pipe open, and the harness waits on
# the pipe, not the process.
emacsclient -e "$form" </dev/null >/dev/null 2>&1 &
client=$!
( sleep 3; kill "$client" ) </dev/null >/dev/null 2>&1 &
dog=$!
wait "$client" 2>/dev/null
# Reaped inside the redirect, or bash reports the kill on this hook's
# stderr as "Terminated" -- which the harness would show.
{ kill "$dog"; wait "$dog"; } 2>/dev/null

first="$(head -n 1 "$verdict" 2>/dev/null)"
case "$first" in
  "owed "*) missing="${first#owed }" ;;
  *) exit 0 ;;   # `ok', or no verdict at all: an outage owes nothing
esac
resolved="$(tail -n +2 "$verdict")"

# The demand this block makes, compared against the ones already made
# this turn. Identical means we have asked and the model did not satisfy
# it -- asking again is the loop the guard exists to prevent.
demand="$missing"
if [[ -n "$prior" ]] && grep -qxF -- "$demand" <<<"$prior"; then
  exit 0
fi

# `mkdir -p' first: a bare `: > "$sentinel" 2>/dev/null' does NOT
# suppress the failure when the directory is absent, because bash
# processes the output redirection before the stderr one -- so the
# sentinel, the loop guard, is never written. Found 2026-08-26.
mkdir -p "$queue_dir" 2>/dev/null
printf '%s\n' "$demand" >> "$sentinel" 2>/dev/null

# COUNTED (TODO.org :ID: 63713df3): one `miss' line per block. A slim
# payload, never "$input": the response text has no business in the
# queue. Fire-and-forget, after the guard is armed and before the block.
jq -c '{session_id, cwd, hook_event_name}' <<<"$input" 2>/dev/null \
  | "$(dirname "${BASH_SOURCE[0]}")/queue-append" miss footnote "$missing" 2>/dev/null

# STDERR AND EXIT 2, not JSON and not exit 0 (TODO.org :ID: 5787bfc6).
# Stderr from a hook that exits 0 goes to the debug log only and Claude
# never sees it; exit 2 is the documented blocking path, and for Stop
# the stderr text is fed back as the reason. Two earlier attempts
# rearranged JSON fields inside that closed channel and changed nothing.
cat >&2 <<EOF2
Unfootnoted tracked :ID:s: $missing. Footnoting is per response, and
covers every block written this turn, not only this last one. Append these
lines to the end matter, after a \`---\` separator:

$resolved
EOF2
exit 2
