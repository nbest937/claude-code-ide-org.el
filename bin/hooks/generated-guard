#!/usr/bin/env bash
# PreToolUse on Edit|Write: block an edit to a rule file claude-org-setup
# generated.
#
# TODO.org :ID: 3cd7b7d3. The rule was "the machinery files under
# .claude/rules/ are generated; edit the reference and re-run setup, never
# the copy". An edit to the copy works, reads back correctly, and is
# silently overwritten by the next promotion. The marker setup writes is
# the whole test -- a hand-maintained rule file carries none and is left
# alone, and the pre-commit guard catches whatever gets past this (a Bash
# redirect, another editor).
#
# Blocks with exit 2 and stderr, and counts itself as a miss. Fails open.

set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0
input="$(cat)"
fp="$(jq -r '.tool_input.file_path // empty' <<<"$input" 2>/dev/null)"
[[ -n "$fp" && -f "$fp" ]] || exit 0

# Below any frontmatter, so ten lines rather than one.
head -10 "$fp" 2>/dev/null | grep -q 'Generated by claude-org-setup' || exit 0

ref="skills/org/references/$(basename "$fp")"
jq -c '{session_id, cwd, hook_event_name}' <<<"$input" 2>/dev/null \
  | "$(dirname "${BASH_SOURCE[0]}")/queue-append" miss generated-edit "$fp" 2>/dev/null

cat >&2 <<MSG
Blocked: $fp is generated by claude-org-setup and the next promotion
overwrites it. Edit the reference it is rendered from -- $ref in the
claude-code-ide-org plugin -- and re-run bin/claude-org-setup.
MSG
exit 2
