#!/usr/bin/env bash
# PostToolUse hook, matcher mcp__emacs-tools__org_set_todo: record which
# session's org_set_todo call most recently set a heading to PLANNING, so
# bin/hooks/exitplanmode-promote-planning can refuse to promote a different
# session's still-in-progress PLANNING heading (TODO.org :ID:
# b95b9fba-f78e-48fe-8546-988709cce309).
#
# No jq -- neither this hook nor exitplanmode-promote-planning needs to
# interpolate an untrusted field value into the emacsclient -e expression,
# only a mktemp-generated temp-file path, which is never session-controlled.
# Writes stdin verbatim to a temp file and lets Elisp parse the JSON itself
# via json-read-file, mirroring claude-code-ide-org--statusline-model-name's
# existing no-jq pattern.
#
# Fails soft, always exit 0 -- this must never block an org_set_todo call
# that already went through (or was denied by) the transition guard.
tmpfile="$(mktemp)"
trap 'rm -f "$tmpfile"' EXIT
cat > "$tmpfile"
emacsclient -e "(claude-code-ide-org--maybe-record-planning-owner \"$tmpfile\")" >/dev/null 2>&1
exit 0
