#!/usr/bin/env bash
# Append one event to this session's append-only org update queue.
#
# The shared writer for the event-queue refactor (TODO.org :ID:
# 32272061-1d78-4726-b13b-90338edb2ba5, under :ID:
# b5f7c5c7-7ad6-4c68-9cce-3479db1f1644). Sessions never mutate live org
# state for clock/TODO changes; they append events here, and a human
# later applies the approved subset through org's own machinery inside a
# genuinely interactive command.
#
# Called by several hooks, each passing the event kind as $1 and reading
# the hook payload on stdin:
#
#   PostToolUse org_set_todo   -> todo
#   PostToolUse org_clock_in   -> clock_in
#   PostToolUse org_clock_out  -> clock_out
#   PostToolUse org_capture    -> capture   (only when it deferred)
#   PostToolUse org_amend      -> amend     (only when it deferred)
#   Stop                       -> pause
#   UserPromptSubmit           -> resume
#   a backstop that fired      -> miss      (rule as $2, detail as $3)
#   PostToolUse org_*          -> refusal   (a miss, only when the reply
#                                            was an "Error: ..." refusal --
#                                            or a body amend onto a heading
#                                            carrying :MISS_RULE:, which is
#                                            a catch by the human)
#
# capture and amend differ from the rest: those tools write the file
# immediately when it is free and only queue when the human has unsaved
# changes in it (TODO.org :ID: b5f94b88). The tool decides; this script
# obeys, by reading which of four fixed prefixes the reply carries. Those
# prefixes are defined as constants in config.el and asserted against the
# cases below by bin/queue-append-test, because a reply reworded on one
# side alone either double-applies the write or silently drops it.
#
# Why the hook writes rather than the MCP tool: session_id is only ever
# present on hook stdin. MCP tools are served by Emacs and never receive
# it, so a tool-side writer could not key files by session. Same division
# of labour as bin/hooks/posttooluse-record-planning-owner.
#
# This also gets subagent attribution for free, which is why the schema
# has agent_id/agent_type. Tool events fire these same hooks inside a
# subagent, and the payload then carries agent_id (unique per subagent
# call) and agent_type (e.g. "Explore"); both are absent on the main
# thread, hence null. No orchestrator-side reconstruction is needed --
# see TODO.org :ID: 16160d23-273b-4510-858e-db18508d04a0, whose original
# "orchestrator writes on the subagent's behalf" baseline this
# supersedes.
#
# Built with jq -n throughout rather than shell interpolation, matching
# bin/hooks/session-pause's reasoning: every field here originates in
# untrusted payload JSON, and jq's own encoder is the only thing that
# should be producing JSON string literals from it.
#
# Fire-and-forget: always exit 0, never block the hook that called it.
# A missing jq, an unwritable queue directory, or a malformed payload
# costs one event, never the caller.

set -uo pipefail

# Which refusals are MISSES (TODO.org :ID: 63713df3; narrowed at its review,
# 2026-09-21). An "Error:" reply is a miss when the caller broke a rule it
# had been given. A probe for a drawer that is not there, "no change", an
# unsaved buffer, a query-language slip, a timeout or an internal error is
# not -- counting those measured the tools' chattiness, not recall.
#
# `fragment|slug', first match wins. The fragments are config.el's own
# wording, so this is a contract of the same kind as the reply prefixes
# below: bin/queue-append-test asserts every fragment still appears there,
# because a refusal reworded on the elisp side alone silently stops being
# counted. A NEW refusal counts nothing until it is added here, which is
# the safe direction.
refusal_table='a heading already carries this title|duplicate-check
a top-level capture needs a category|category-missing
title begins with the TODO keyword|keyword-in-title
give slice|slice-hybrid
so it is a story|slice-hybrid
unresolvable :ID: link|id-from-memory
no org heading found with|id-from-memory
resolves to no heading|id-from-memory
is not a TODO keyword|unknown-keyword
is identity, not annotation|identity-property
drawer must be one of|drawer-misuse
replace into a drawer is not offered|drawer-misuse
is closed, and a closed slice|slice-membership
carries no TODO keyword on disk|slice-membership'

if [ "${1:-}" = "--refusal-fragments" ]; then
  printf '%s\n' "$refusal_table" | cut -d'|' -f1
  exit 0
fi

kind="${1:-}"
case "$kind" in
  todo|clock_in|clock_out|pause|resume|capture|amend) ;;
  # A permission block: the agent is stalled waiting on a human, which
  # no other event can express. `Stop' fires when a *turn* ends, and a
  # turn blocked mid-flight has not ended -- see TODO.org :ID: f4e628ce.
  # Paired by tool_use_id at review time, not here: this script stays a
  # dumb appender and never reads back what it has written.
  block_start|block_end) ;;
  # A backstop fired: a hook blocked, or a tool refused (TODO.org :ID:
  # 63713df3). The sentinels that guard those hooks say "at least once
  # this session" and are cleared or never cleared for loop-guard
  # reasons, so neither is a count; this line is. `miss' is called by a
  # hook that has already decided, with the rule as $2; `refusal' is
  # wired to PostToolUse and decides here, on the reply.
  #
  # NOT in config.el's `--queue-kinds', deliberately: the reader drops an
  # unknown kind, so a miss never reaches the review buffer. It is a
  # measurement, not a proposal, and there is nothing to apply.
  #
  # A FLOOR, never the rate. It counts what a hook or a tool caught. The
  # misses a human catches in conversation reach no file at all.
  miss|refusal) ;;
  # One per session that did org work, written by conventions-inject on
  # the first org_* call (TODO.org :ID: 158d7e80). It exists to be the
  # miss rate's denominator: with time tracking off -- every consumer's
  # default -- no guidepost is written, so a session that missed nothing
  # and queued nothing left no line and could not be counted. Ungated for
  # that reason, and absent from config.el's `--queue-kinds' like `miss',
  # so the reader drops it.
  session) ;;
  *) exit 0 ;;
esac

rule="${2:-}"
detail="${3:-}"
[[ "$kind" != miss || -n "$rule" ]] || exit 0

# Time tracking self-gates here, because hooks.json has no conditional
# form: a shipped-but-disabled hook has to refuse for itself. The plugin
# declares a `time_tracking' boolean in .claude-plugin/plugin.json's
# userConfig, and Claude Code exports it to hook processes as
# CLAUDE_PLUGIN_OPTION_TIME_TRACKING.
#
# DEFAULT OFF, and the absent case is the one that matters: a consumer
# who never sets it gets task tracking only, and so does one whose Claude
# Code predates userConfig, where the variable simply never appears.
# Defaulting on would hand that consumer guideposts they never asked for,
# which is the thing this whole arrangement exists to prevent.
#
# A repo wiring these scripts through its OWN .claude/settings.json sets
# the variable in the command string -- wiring the row is the opt-in
# there, and there is no plugin option to read.
#
# todo, capture and amend are deliberately absent below: they are task
# tracking and ship unconditionally.
case "$kind" in
  clock_in|clock_out|pause|resume|block_start|block_end)
    [ "${CLAUDE_PLUGIN_OPTION_TIME_TRACKING:-false}" = "true" ] || exit 0 ;;
esac

command -v jq >/dev/null 2>&1 || exit 0

input="$(cat)"

session_id="$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)"
# Without a session_id there is no file to write to -- the queue is keyed
# by it. Drop the event rather than inventing a filename, so a stray
# unkeyed event can never be mistaken for a real session's work.
[[ -n "$session_id" ]] || exit 0

# Refuse anything that isn't a plain filename component. session_id is
# interpolated into a path below, and this is the only place untrusted
# payload data reaches the filesystem.
case "$session_id" in
  *[!A-Za-z0-9._-]*|''|.|..) exit 0 ;;
esac

# The tool wrappers return an "Error: ..." string rather than throwing
# when :ID: resolution fails (see claude-code-ide-org--at-id). Treat that
# as "nothing happened" -- a bad :ID: must not enter the queue and
# resurface as a mystery at review time.
#
# tool_response arrives in several shapes and the extraction has to
# recurse, not just branch once. A live MCP tool_response is an array of
# content blocks -- [{"type":"text","text":"Error: ..."}] -- so a
# single-level `map(tostring)' stringifies each *block* to its JSON and
# yields a string starting with `{', which no amount of matching on
# `Error:' will ever catch. That was a real escape: a clock_in for a
# nonexistent :ID: reached the queue on 2026-08-11 and was only caught by
# testing against a live payload rather than the hand-written string
# shapes the suite had been using. Recursing also covers the
# {"content":[...]} wrapper, which the old object branch broke on
# identically.
#
# Plain strings still pass through unchanged, so pre-existing callers and
# the older reply shapes are unaffected.
response=""
if [[ "$kind" == todo || "$kind" == clock_in || "$kind" == clock_out \
   || "$kind" == capture || "$kind" == amend || "$kind" == refusal ]]; then
  response="$(jq -r '
    def totext:
      if type == "object" then (.text // .content // .result // "" | totext)
      elif type == "array" then (map(totext) | join(" "))
      else tostring end;
    (.tool_response // "") | totext' <<<"$input" 2>/dev/null)"
  # The same test read both ways: for the queued tools an error means
  # nothing happened and nothing is queued; for `refusal' the error IS
  # the event, and anything else is an ordinary call and not a miss.
  case "$kind:$response" in
    refusal:Error:*)
      slug=""
      while IFS='|' read -r fragment candidate; do
        [ -n "$fragment" ] || continue
        case "$response" in *"$fragment"*) slug="$candidate"; break ;; esac
      done <<<"$refusal_table"
      # Not in the table: an error, but not a rule missed.
      [ -n "$slug" ] || exit 0
      rule="refusal:$slug"
      # Truncated: a refusal can quote a whole query or list every
      # category, and the line must stay under the atomic-append size.
      detail="${response:0:300}"
      kind=miss ;;
    refusal:*)
      # Not a refusal -- but it may be a CATCH (TODO.org :ID: 158d7e80). A
      # body amend onto a heading that carries :MISS_RULE: is the session
      # recording a miss the human caught, and the write-through gate
      # below would drop it: an immediate amend never reaches the queue.
      # Body amends only -- a drawer amend is composition and a replace
      # is revision, so setting such a heading up counts nothing.
      [ "$(jq -r '(.tool_name // "") | test("org_amend$")' <<<"$input" 2>/dev/null)" = true ] || exit 0
      [ "$(jq -r '.tool_input | ((.drawer // "") == "" and (.replace // false) != true)' <<<"$input" 2>/dev/null)" = true ] || exit 0
      amend_id="$(jq -r '.tool_input.id // empty' <<<"$input" 2>/dev/null)"
      case "$amend_id" in ''|*[!A-Za-z0-9-]*) exit 0 ;; esac
      org_root="${CLAUDE_PROJECT_DIR:-$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null)}"
      # Anchored on the heading's OWN property drawer, never on the bare
      # strings: an id or the property name quoted in some other body
      # must not make that heading a miss heading. footnote-check's
      # resolve_id is the same shape, for the same recorded reason.
      slug="$(awk -v id="$amend_id" '
        /^\*+ / { indrawer = 0; hit = 0; rule = "" }
        /^:PROPERTIES:[ \t]*$/ { indrawer = 1; next }
        indrawer && /^:END:[ \t]*$/ { if (hit && rule != "") { print rule; exit } indrawer = 0 }
        indrawer && $1 == ":ID:" && index($2, id) == 1 { hit = 1 }
        indrawer && $1 == ":MISS_RULE:" { rule = $2 }
      ' "$org_root/TODO.org" "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/TODO.org" 2>/dev/null | head -1)"
      # The second file is the plugin's own tracker: the Miss: headings
      # live there, since the rules missed are the plugin's, so a catch
      # made while working in a consumer project still resolves. `cwd' on
      # the line records where it happened.
      [ -n "$slug" ] || exit 0
      detail="$(jq -r '.tool_input.note // ""' <<<"$input" 2>/dev/null)"
      # Who caught it, from the note's first word: `user: ...' or
      # `self: ...'. Kept in the RULE so every reader splits the two
      # series without parsing detail -- what gets past the session, and
      # what it repairs on its own, are different measurements. Anything
      # else is `unmarked' rather than a guess. (sed -E: BSD sed has no
      # alternation in basic regexps, and macOS is where this runs.)
      who="$(tr '[:upper:]' '[:lower:]' <<<"$detail" | sed -nE 's/^[[:space:]]*(user|self)[^[:alnum:]].*/\1/p')"
      rule="caught:$slug/${who:-unmarked}"
      kind=miss ;;
    *:Error:*) exit 0 ;;
  esac
fi

# org_clock_out takes no id argument -- the running clock is the only
# thing that knows which heading is being closed -- so recover it from
# the tool's own reply, which reports the id it actually closed as
# "Clocked out: \"HEADING\" (id: ID)". Authoritative in a way a
# caller-supplied argument would not be: it cannot disagree with what
# happened. Without this the event carries a null id and a clock_out read
# on its own cannot name its heading.
recovered_id=""
if [[ "$kind" == clock_out ]]; then
  recovered_id="$(sed -n 's/.*(id: \([^)]*\)).*/\1/p' <<<"$response")"
fi

# The write-through gate. org_capture and org_amend write the file
# themselves when it is free, and queue only when it is busy, so this
# script must append for exactly one of those two outcomes -- appending
# for both would apply the same edit twice, once now and once at review.
#
# The four literals here are the other half of a contract with config.el's
# claude-code-ide-org--reply-{captured,queued-capture,amended,queued-amend}.
# bin/queue-append-test asserts they still agree, so rewording one side
# alone fails the suite rather than silently changing behaviour.
#
# An unrecognised reply drops the event. That is the safe direction: a
# drop loses one proposal the human can restate, while a wrong append
# writes a heading twice and neither copy announces itself.
if [[ "$kind" == capture || "$kind" == amend ]]; then
  case "$response" in
    "Queued capture: "*|"Queued amend: "*) ;;
    *) exit 0 ;;
  esac
fi

# org_capture mints the new heading's :ID: itself and reports it as
# "(ID: ...)", so -- exactly like clock_out's "(id: ...)" above -- the id
# has to be recovered from the reply rather than read off tool_input,
# which never carried one. Keeping the pre-minted id is what lets a
# caller act on the heading before it exists.
if [[ "$kind" == capture ]]; then
  recovered_id="$(sed -n 's/.*(ID: \([^)]*\)).*/\1/p' <<<"$response")"
fi

# org_set_todo reports the state the heading held *before* the change, as
# "TODO state set to DOING (was NEXT): \"HEADING\"". Recovered from the
# reply for the same reason as the id above, and emphatically not by
# asking Emacs: this script must stay runnable with no Emacs at all,
# which is the premise the whole queue rests on. The review command uses
# it to notice at apply time that reality has moved past a queued
# transition (TODO.org :ID: f9f61c04-150b-4ee7-96c9-582cf2bda95a).
#
# A heading with no keyword reports "(was none)", carried through
# verbatim rather than normalised to null, so it stays distinguishable
# from the null that events predating this field carry -- "the heading
# had no keyword" and "we do not know what it had" must not collapse
# into the same value, or the staleness check silently stops firing.
recovered_from=""
if [[ "$kind" == todo ]]; then
  recovered_from="$(sed -n 's/.*(was \([^)]*\)).*/\1/p' <<<"$response")"
fi

queue_dir="${CLAUDE_ORG_QUEUE_DIR:-$HOME/.claude/org-updates}"
mkdir -p "$queue_dir" 2>/dev/null || exit 0

# One line, built and encoded entirely by jq. Field names and the
# timestamp format deliberately match the existing audit log written by
# claude-code-ide-org--log-event, so both logs read the same way.
#
# id/state/from are null for the kinds that don't carry them: pause/resume
# are session-global (nothing in them names a heading -- that attribution
# is what the clock_in/clock_out events exist to provide), and state/from
# are meaningful only for todo.
#
# block_start/block_end must be nulled *explicitly* rather than left to
# fall through, and the reason is a trap rather than tidiness: their
# payload is the blocked tool's own, so `tool_input.id' is that tool's
# argument. A permission prompt on org_set_todo would otherwise attribute
# the block to whatever heading that call named -- a heading the block
# has nothing to do with. Same for `note'. A block names no heading by
# construction; it is a fact about the session.
#
# tool_name needs no field of its own: `source' already resolves to it.
line="$(jq -n -c \
  --arg ts "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
  --arg kind "$kind" \
  --arg session_id "$session_id" \
  --arg recovered_id "$recovered_id" \
  --arg recovered_from "$recovered_from" \
  --arg rule "$rule" \
  --arg detail "$detail" \
  --argjson payload "$(jq -c '.' <<<"$input" 2>/dev/null || echo '{}')" \
  '{
     ts: $ts,
     kind: $kind,
     id: (if $kind == "pause" or $kind == "resume" or $kind == "miss" or $kind == "session"
             or $kind == "block_start" or $kind == "block_end" then null
          else ($payload.tool_input.id
                // (if $recovered_id == "" then null else $recovered_id end))
          end),
     state: (if $kind == "todo" then ($payload.tool_input.state // null)
             elif $kind == "capture" then
               ($payload.tool_input.initial_state // null)
             else null end),
     from: (if $kind == "todo" and $recovered_from != "" then $recovered_from
            else null end),
     note: (if $kind == "pause" or $kind == "resume" or $kind == "miss" or $kind == "session"
               or $kind == "block_start" or $kind == "block_end" then null
            else ($payload.tool_input.note // null) end),
     title:  (if $kind == "capture" then ($payload.tool_input.title // null) else null end),
     target: (if $kind == "capture" then ($payload.tool_input.target // null) else null end),
     tags:   (if $kind == "capture" then ($payload.tool_input.tags // null) else null end),
     category: (if $kind == "capture" then ($payload.tool_input.category // null) else null end),
     text:   (if $kind == "amend" then ($payload.tool_input.text // null) else null end),
     drawer: (if $kind == "amend" then ($payload.tool_input.drawer // null) else null end),
     rule:   (if $kind == "miss" then $rule else null end),
     detail: (if $kind == "miss" and $detail != "" then $detail else null end),
     tool_use_id: (if $kind == "block_start" or $kind == "block_end"
                   then ($payload.tool_use_id // null) else null end),
     session_id: $session_id,
     cwd: ($payload.cwd // null),
     agent_id: ($payload.agent_id // null),
     agent_type: ($payload.agent_type // null),
     source: ($payload.tool_name // $payload.hook_event_name // $kind)
   }' 2>/dev/null)"

[[ -n "$line" ]] || exit 0

# A single write of one short line to an O_APPEND fd: atomic on POSIX for
# anything under PIPE_BUF, so concurrent writers can never interleave a
# partial line. No locking needed, and none wanted -- a lock is another
# thing that can wedge and block a hook.
printf '%s\n' "$line" >> "$queue_dir/$session_id.jsonl" 2>/dev/null

exit 0
