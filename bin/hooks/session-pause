#!/usr/bin/env bash
# Stop hook: record a `pause` guidepost the moment Claude finishes
# responding and control returns to the user.
#
# Before the 2026-08-11 cutover (TODO.org :ID:
# feba67eb-35b3-48bd-a892-8ecd47ca52e0) this also called
# claude-code-ide-org-session-pause through `emacsclient -e` to close
# the live clock at the turn boundary. It no longer touches Emacs: the
# MCP tools open no clocks, so there is nothing here to pause. What the
# turn boundary produces now is evidence -- a timestamp saying "this
# session stopped working here" -- and the review command decides what
# it brackets.
#
# Why that is better rather than merely simpler: a guidepost is written
# by appending one line to a file, so it survives with no Emacs running,
# no server socket, and no risk of a hook wedging on an `emacsclient`
# call that cannot complete. The pause/resume stream also stays
# undecimated in the queue, which the retired :SESSIONS: drawer never
# managed.
#
# Fire-and-forget: always exit 0, never block Claude Code.
exec "$(dirname "${BASH_SOURCE[0]}")/queue-append" pause
