#!/usr/bin/env bash
# Stop hook: pause the running org clock the moment Claude finishes
# responding and control returns to the user. Fire-and-forget — never
# blocks or reports back to Claude Code, and fails soft if Emacs isn't
# reachable (no server running yet, etc).
#
# Passes this session's session_id through to
# claude-code-ide-org-session-pause so it can no-op instead of pausing
# a different concurrent session's actively-running clock (see TODO.org
# :ID: 337f7fb2-b9e9-4c02-82dd-d88e60df364b). Built via jq's own
# JSON-string encoding rather than naive shell interpolation into the
# emacsclient -e expression — JSON string-escaping is a safe superset
# of elisp string-literal escaping for the plain-ASCII UUIDs Claude
# Code uses, and this avoids any injection risk from untrusted data.
# An empty/missing session_id is passed through as elisp nil, not an
# empty string, matching the function's own "nil means no session
# context" default.
input="$(cat)"

session_id="$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)"

if [[ -n "$session_id" ]]; then
  session_id_elisp="$(printf '%s' "$session_id" | jq -R -s .)"
else
  session_id_elisp="nil"
fi

emacsclient -e "(claude-code-ide-org-session-pause $session_id_elisp)" >/dev/null 2>&1

# Also append a `pause` guidepost to this session's event queue (TODO.org
# :ID: 32272061-1d78-4726-b13b-90338edb2ba5). Deliberately ADDITIVE for
# now: the emacsclient call above still does the real clocking, so this
# changes no behavior and only starts accumulating queue data. Removing
# the emacsclient half is feba67eb's cutover commit -- doing it here
# would stop pausing the live clock at turn boundaries while the MCP
# tools still open real clocks, inflating every interval with idle time,
# and nothing yet exists to apply the queued events instead.
printf '%s' "$input" | "$(dirname "${BASH_SOURCE[0]}")/queue-append" pause

exit 0
