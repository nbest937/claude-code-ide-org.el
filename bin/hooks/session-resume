#!/usr/bin/env bash
# UserPromptSubmit hook: record a `resume` guidepost the moment the user
# sends the next prompt.
#
# The other half of bin/hooks/session-pause -- see its header for why
# both stopped calling `emacsclient` at the 2026-08-11 cutover.
#
# One thing genuinely goes away with the emacsclient call, and it is
# worth naming: this used to run `org-clock-in-last`, which would resume
# the wrong heading whenever the user's next prompt was about something
# else (TODO.org :ID: 582cc7f4-41a2-4666-ad3f-1b76b459147e). A guidepost
# carries no heading at all -- attribution comes from the surrounding
# clock_in/clock_out events at review time -- so there is no longer a
# wrong heading to guess.
#
# It also clears bin/hooks/footnote-check's per-turn sentinel, since a
# new prompt is exactly what starts a new turn. That hook may block a
# turn at most once, and this is what re-arms it (TODO.org :ID:
# 2758f3a0). Clearing it here rather than in the Stop hook itself is
# deliberate: a Stop hook that cleared its own sentinel could block, be
# re-entered, and block again forever, which is the loop the docs
# describe no guard against.
#
# Fire-and-forget: always exit 0, never block Claude Code.

input="$(cat)"

if command -v jq >/dev/null 2>&1; then
  session_id="$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)"
  case "$session_id" in
    ''|.|..|*[!A-Za-z0-9._-]*) ;;
    *) rm -f "${CLAUDE_ORG_QUEUE_DIR:-$HOME/.claude/org-updates}/$session_id.footnote-blocked" 2>/dev/null ;;
  esac
fi

printf '%s' "$input" | "$(dirname "${BASH_SOURCE[0]}")/queue-append" resume
exit 0
