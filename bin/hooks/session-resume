#!/usr/bin/env bash
# UserPromptSubmit hook: record a `resume` guidepost the moment the user
# sends the next prompt.
#
# The other half of bin/hooks/session-pause -- see its header for why
# both stopped calling `emacsclient` at the 2026-08-11 cutover.
#
# One thing genuinely goes away with the emacsclient call, and it is
# worth naming: this used to run `org-clock-in-last`, which would resume
# the wrong heading whenever the user's next prompt was about something
# else (TODO.org :ID: 582cc7f4-41a2-4666-ad3f-1b76b459147e). A guidepost
# carries no heading at all -- attribution comes from the surrounding
# clock_in/clock_out events at review time -- so there is no longer a
# wrong heading to guess.
#
# Fire-and-forget: always exit 0, never block Claude Code.
exec "$(dirname "${BASH_SOURCE[0]}")/queue-append" resume
