#!/usr/bin/env bash
# Test harness for .githooks/prepare-commit-msg, same register as
# bin/queue-append-test: fixtures, controlled env, positive assertions.
# The hook's contract (TODO.org :ID: 6d1a5192): never touch the
# Co-Authored-By trailer -- the session writes it, and a missing one is
# commit-msg's to refuse -- and inside a Claude Code session
# (CLAUDECODE=1) add Claude-Session from CLAUDE_CODE_BRIDGE_SESSION_ID
# when absent, after a blank line. Never block a commit.
set -uo pipefail
unset CLAUDE_CODE_SESSION_ID  # else a provoked refusal counts as a miss in the calling session
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
hook="$repo_root/.githooks/prepare-commit-msg"
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
pass=0 fail=0
check() {
  local label="$1" want="$2" got="$3"
  if [[ "$want" == "$got" ]]; then echo "ok   - $label"; pass=$((pass + 1))
  else echo "FAIL - $label"; echo "       want: $want"; echo "       got:  $got"; fail=$((fail + 1)); fi
}

# The old hook read the model from here; a settings file naming another
# model must change nothing now.
echo '{"model":"sonnet"}' > "$work/settings.json"
run() { # run <CLAUDECODE or -> <msgfile> [bridge id, - for none]
  local cc="$1" msg="$2" sid="${3:-session_TEST}"
  local -a envs=(CLAUDE_SETTINGS_FILE="$work/settings.json")
  [[ "$sid" != "-" ]] && envs+=(CLAUDE_CODE_BRIDGE_SESSION_ID="$sid")
  if [[ "$cc" == "-" ]]; then
    env -u CLAUDECODE -u CLAUDE_CODE_BRIDGE_SESSION_ID "${envs[@]}" bash "$hook" "$msg" message
  else
    env -u CLAUDE_CODE_BRIDGE_SESSION_ID CLAUDECODE="$cc" "${envs[@]}" bash "$hook" "$msg" message
  fi
}
session='Claude-Session: https://claude.ai/code/session_TEST'

# 1. outside a Claude session: byte-identical
printf 'subject\n\nbody\n' > "$work/m1"; cp "$work/m1" "$work/m1.orig"
run - "$work/m1"
check "non-Claude commit untouched" "$(cat "$work/m1.orig")" "$(cat "$work/m1")"

# 2. a current trailer survives byte for byte; the session line joins its block
printf 'subject\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n' > "$work/m2"
run 1 "$work/m2"
check "a current trailer is kept exactly" "1" "$(grep -cx 'Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>' "$work/m2")"
check "and only one Co-Authored-By remains" "1" "$(grep -c '^Co-Authored-By:' "$work/m2")"
check "the session line joins the trailer block" \
  "$(printf 'subject\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n%s' "$session")" "$(cat "$work/m2")"

# 3. a stale trailer is not "corrected" from settings.json either
printf 'subject\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>\n%s\n' "$session" > "$work/m3"
cp "$work/m3" "$work/m3.orig"
run 1 "$work/m3"
check "a stale trailer and present session line: byte-identical" "$(cat "$work/m3.orig")" "$(cat "$work/m3")"

# 4. a bare message gains the session line and no Co-Authored-By
printf 'subject only\n' > "$work/m4"
run 1 "$work/m4"
check "no Co-Authored-By is appended" "0" "$(grep -c 'Co-Authored-By' "$work/m4")"
check "the session line follows a blank line" "$(printf 'subject only\n\n%s' "$session")" "$(cat "$work/m4")"

# 5. a one-line merge message with no trailing newline, as `git merge --no-edit' writes
printf "Merge branch 'main' into feature/x" > "$work/m5"
run 1 "$work/m5"
check "a merge subject stays alone in its paragraph" \
  "$(printf "Merge branch 'main' into feature/x\n\n%s" "$session")" "$(cat "$work/m5")"

# 6. no bridge id: nothing to add, nothing touched
printf 'subject\n\nbody\n' > "$work/m6"; cp "$work/m6" "$work/m6.orig"
run 1 "$work/m6" -
check "no bridge id leaves the message alone" "$(cat "$work/m6.orig")" "$(cat "$work/m6")"

# 7. never blocks
run 1 "$work/does-not-exist"
check "a missing message file still exits 0" "0" "$?"

echo
echo "prepare-commit-msg-test: $pass passed, $fail failed"
exit $((fail > 0))
