#!/usr/bin/env bash
# Can a web page reach the IDE companion? TODO.org :ID: d7b2f50f.
#
# claude-code-ide's companion WebSocket checks no Origin, so a page in the
# user's browser can connect, and with `claude-code-ide-enable-execute-code'
# on it can run elisp in Emacs. This connects the way such a page would,
# with Origin: https://evil.example.com, then calls tools/list and
# executeCode with a harmless expression. It is the test that must pass
# once d7b2f50f is fixed, and the proof behind the upstream report,
# b24abffd. The core is elisp (bin/lib/probe-companion-origin.el), run as
# a client in a batch Emacs, never through the running one.
#
# Usage: bin/probe-companion-origin [--live] [PORT...]
#   PORTs are probed as given -- fixture servers, normally. A port that a
#   live Emacs lockfile names is a real companion, and probing one cuts
#   its Claude session off from Emacs: upstream makes any connection the
#   session's client and clears it on close (TODO.org :ID: 207e9044), so
#   the session needs /ide afterwards. Such a port needs --live, and so
#   does giving no PORT, which probes every Emacs lockfile in
#   ~/.claude/ide (or $PROBE_LOCKFILE_DIR) whose recorded pid is still
#   running. A crashed Emacs leaves its lockfile behind, and that port,
#   closed or reused, would decide the run for a reason unrelated to the
#   companions.
# Exit: 0 every companion refused -- failed the handshake, or closed the
#   socket after it without answering; 1 one answered the foreign Origin;
#   2 one was unreachable or gave no verdict (silent past the timeout,
#   PROBE_SECONDS, default 10), a PORT was not a port, a live companion
#   was named without --live, or there was nothing to probe.
#
# Not a suite: it needs live companions, so bin/test-all must not run it.
# bin/probe-companion-origin-test drives it against fixture servers.
set -uo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
dir="${PROBE_LOCKFILE_DIR:-$HOME/.claude/ide}"
live=0
if [[ "${1:-}" == --live ]]; then live=1; shift; fi

# The pid in PORT's lockfile when it names a running Emacs, else nothing.
# Whitespace-tolerant: a pretty-printed lockfile is still a lockfile.
live_pid () { # PORT
  local f="$dir/$1.lock" pid
  [[ -f "$f" ]] && grep -qE '"ideName"[[:space:]]*:[[:space:]]*"Emacs"' "$f" || return 1
  pid="$(grep -oE '"pid"[[:space:]]*:[[:space:]]*[0-9]+' "$f" | grep -oE '[0-9]+$')"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && printf '%s' "$pid"
}

if (($# == 0)); then
  if ((live == 0)); then
    echo "probe-companion-origin: with no PORT this probes the live companions, and each probed session" >&2
    echo "  loses its link to Emacs until /ide; pass --live to mean it, or give a fixture's port" >&2
    exit 2
  fi
  for f in "$dir"/*.lock; do
    [[ -e "$f" ]] && grep -qE '"ideName"[[:space:]]*:[[:space:]]*"Emacs"' "$f" || continue
    port="$(basename "$f" .lock)"
    if ! live_pid "$port" >/dev/null; then
      echo "probe-companion-origin: $port: skipped -- stale lockfile, its pid is not running" >&2
      continue
    fi
    set -- "$@" "$port"
  done
  if (($# == 0)); then
    echo "probe-companion-origin: no live Emacs lockfile in $dir; pass a port" >&2
    exit 2
  fi
fi
# Every argument reaches Emacs's own command line: `--help' would print
# Emacs's usage and exit 0, and `abc' would become port 0, which url.el
# reads as the default, 80.
for p in "$@"; do
  if ! [[ "$p" =~ ^[1-9][0-9]{0,4}$ ]] || ((p > 65535)); then
    echo "probe-companion-origin: not a port: $p" >&2
    exit 2
  fi
  if pid="$(live_pid "$p")"; then
    if ((live == 0)); then
      echo "probe-companion-origin: $p is a live companion (Emacs pid $pid); probing it cuts its session" >&2
      echo "  off from Emacs until /ide -- pass --live to mean it" >&2
      exit 2
    fi
    echo "probe-companion-origin: $p: live companion -- run /ide in its Claude session afterwards" >&2
  fi
done
exec "$here/lib/batch-emacs" -l "$here/lib/probe-companion-origin.el" \
  -f probe-companion-origin-main "$@"
