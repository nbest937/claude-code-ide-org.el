#!/usr/bin/env bash
# Tests for bin/probe-companion-origin (TODO.org :ID: d7b2f50f), against
# fixture servers in a second batch Emacs: no live companion, nothing in
# ~/.claude/ide read. Always prints a result line -- silence is not a
# passing check.
set -uo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
probe="$repo/bin/probe-companion-origin"
tmp="$(mktemp -d)"
server_pid=""
trap 'stop; rm -rf "$tmp"' EXIT
pass=0 fail=0
check () { # name expected actual
  if [[ "$2" == "$3" ]]; then printf 'ok   - %s\n' "$1"; pass=$((pass+1))
  else printf 'FAIL - %s: wanted [%s], got [%s]\n' "$1" "$2" "$3"; fail=$((fail+1)); fi
}

# One fixture server per MODE, on a port the OS picks, written to a file:
#   answer  a companion with no Origin check: answers every call
#   deny    the same with executeCode switched off
#   greet   answers, but opens with a frame that is not JSON
#   close   the planned fix: closes any socket that carries an Origin
#   403     refuses the handshake with an HTTP 403
cat > "$tmp/server.el" <<'EOF'
(require 'websocket)
(let* ((mode (pop command-line-args-left))
       (out (pop command-line-args-left))
       (reply
        (lambda (ws frame)
          (let* ((msg (json-parse-string (websocket-frame-text frame)
                                         :object-type 'alist))
                 (id (alist-get 'id msg))
                 (exec (equal (alist-get 'name (alist-get 'params msg))
                              "executeCode")))
            (websocket-send-text
             ws (json-encode
                 (if (and exec (equal mode "deny"))
                     `((jsonrpc . "2.0") (id . ,id)
                       (error . ((code . -32601)
                                 (message . "Unknown tool: executeCode"))))
                   `((jsonrpc . "2.0") (id . ,id)
                     (result . ((content . [((type . "text")
                                             (text . "ran"))]))))))))))
       (server
        (if (equal mode "403")
            (make-network-process
             :name "fixture" :server t :family 'ipv4 :host 'local :service t
             :filter (lambda (proc _out)
                       (process-send-string
                        proc "HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n")
                       (delete-process proc)))
          (websocket-server
           t :host 'local
           :on-open (lambda (ws)
                      (pcase mode
                        ("close" (when (websocket-origin ws) (websocket-close ws)))
                        ("greet" (websocket-send-text ws "hello"))))
           :on-message reply))))
  (with-temp-file out
    (insert (number-to-string (process-contact server :service))))
  ;; Killing the batch-emacs wrapper can orphan the Emacs under it, so
  ;; the server exits by itself: when its port file goes, or after a minute.
  (let ((deadline (+ (float-time) 60)))
    (while (and (file-exists-p out) (< (float-time) deadline))
      (accept-process-output nil 0.1)))
  (kill-emacs 0))
EOF

serve () { # MODE -> sets $port, $server_pid
  rm -f "$tmp/port"
  "$repo/bin/lib/batch-emacs" -l "$tmp/server.el" "$1" "$tmp/port" \
    >"$tmp/server.log" 2>&1 &
  server_pid=$!
  for _ in $(seq 50); do [[ -s "$tmp/port" ]] && break; sleep 0.1; done
  port="$(cat "$tmp/port" 2>/dev/null)"
}
stop () { # remove the port file and wait for the server to exit
  rm -f "$tmp/port"
  [[ -n "$server_pid" ]] && wait "$server_pid" 2>/dev/null
  server_pid=""
}
run () { "$probe" "$@" 2>&1; echo "rc=$?"; }
has () { grep -q -- "$1" <<<"$2" && echo yes || echo no; }

serve answer; out="$(run "$port")"; stop
check "an answering companion exits 1" yes "$(has '^rc=1$' "$out")"
check "and says executeCode ran" yes "$(has 'executeCode ran' "$out")"

serve deny; out="$(run "$port")"; stop
check "executeCode off still exits 1" yes "$(has '^rc=1$' "$out")"
check "and says executeCode was refused" yes "$(has 'executeCode refused (Unknown tool' "$out")"

serve greet; out="$(run "$port")"; stop
check "a non-JSON frame does not turn OPEN into a pass" yes "$(has '^rc=1$' "$out")"

serve close; out="$(run "$port")"; stop
check "closing after the handshake is a refusal" yes "$(has '^rc=0$' "$out")"
check "and says the socket closed unanswered" yes "$(has 'closed unanswered' "$out")"

serve 403; out="$(run "$port")"; stop
check "a 403 handshake is a refusal" yes "$(has '^rc=0$' "$out")"

serve close; closed="$port"; stop
out="$(run "$closed")"
check "a closed port is unreachable" yes "$(has '^rc=2$' "$out")"

# Discovery: a live lockfile (this shell's pid) on a refusing port, and a
# stale one (a pid that has exited) on a closed port. Without the pid
# check the stale one makes the run exit 2.
serve 403; locks="$tmp/locks"; mkdir -p "$locks"
sleep 0 & dead=$!; wait "$dead"
printf '{"pid":%d,"ideName":"Emacs","transport":"ws"}' $$ > "$locks/$port.lock"
printf '{"pid":%d,"ideName":"Emacs","transport":"ws"}' "$dead" > "$locks/$closed.lock"
out="$(PROBE_LOCKFILE_DIR="$locks" run)"; stop
check "a stale lockfile is skipped" yes "$(has "$closed: skipped -- stale lockfile" "$out")"
check "and does not decide the run" yes "$(has '^rc=0$' "$out")"
rm -f "$locks/$port.lock"
out="$(PROBE_LOCKFILE_DIR="$locks" run)"
check "only stale lockfiles is nothing to probe" yes "$(has '^rc=2$' "$out")"

out="$(run --help)"
check "--help is not handed to Emacs" yes "$(has '^rc=2$' "$out")"
out="$(run abc)"
check "a non-numeric port is refused" yes "$(has 'not a port: abc' "$out")"

echo "probe-companion-origin-test: $pass passed, $fail failed"
((fail == 0))
