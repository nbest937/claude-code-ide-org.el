#!/usr/bin/env bash
# Run the ERT test suite for the claude-code-ide-org MCP tool wrappers.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
module_dir="$repo_root/modules/tools/claude-code-ide-org"

# Emacs ships its own bundled org-mode (and, of course, no org-ql/peg/ts
# at all), which -Q would otherwise load or simply miss instead of the
# straight-managed checkout Doom actually uses. This bit us once already:
# org-element-type-p only exists in the newer straight checkout, not
# the bundled org, so tests silently ran against the wrong org version
# until a load-path fix was added. Put every straight-built package's
# directory first on load-path — not just org's — so tests run against
# the same packages (org, org-ql and its own deps, etc.) the real
# environment uses.
# `|| true' because under set -e a failing find (e.g. the directory does
# not exist at all) would kill the script HERE, exit 1, with no message --
# the refusal below must be the thing that fires, not a silent death.
build_root="$(find "$HOME/.config/emacs/.local/straight" -maxdepth 1 -name 'build-*' -type d 2>/dev/null | head -1 || true)"

# Refuse rather than fall back (TODO.org :ID: 1ed7b2b4).  Without the
# straight build dir the suite would run against Emacs's bundled org --
# where a missing 9.7+ feature is indistinguishable from a broken one.
# That silent fallback is the exact failure the org-dev skill documents;
# make it loud instead.
if [[ -z "$build_root" ]]; then
  echo "ERROR: no straight build-* dir under ~/.config/emacs/.local/straight" >&2
  echo "Refusing to run against the bundled org (needs org 9.7+; :ID: 1ed7b2b4)" >&2
  exit 2
fi

emacs_args=(--batch -Q)
if [[ -n "$build_root" ]]; then
  for pkg_dir in "$build_root"/*/; do
    [[ -d "$pkg_dir" ]] && emacs_args+=(--eval "(add-to-list 'load-path \"${pkg_dir%/}\")")
  done
fi

# `command emacs', not bare `emacs'. This script is already safe -- a
# #!/usr/bin/env bash script gets a non-interactive shell, where the
# user's `emacs()' wrapper (which runs `open -a Emacs' and returns 0 with
# no output for anything lacking -nw) is not defined. Spelled out anyway,
# because a script in the repo that documents this hazard should not read
# as if unaware of it. See TODO.org :ID: 4f9e552a.
exec command emacs "${emacs_args[@]}" \
  -l "$module_dir/config.el" \
  -l "$module_dir/config-test.el" \
  -f ert-run-tests-batch-and-exit
