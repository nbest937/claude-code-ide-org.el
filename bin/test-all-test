#!/usr/bin/env bash
# Prove bin/test-all demands positive evidence (TODO.org :ID: 94e6b615):
# a copy of the runner in a scratch bin/, beside fake suites, one case
# per way a suite can look green without being green.
set -uo pipefail
unset CLAUDE_CODE_SESSION_ID  # else a provoked refusal counts as a miss in the calling session

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

pass=0 fail=0
check() {
  if [[ "$2" == "$3" ]]; then echo "ok   - $1"; pass=$((pass + 1))
  else echo "FAIL - $1: wanted [$2], got [$3]"; fail=$((fail + 1)); fi
}

# fresh ERT_BODY -- a scratch bin/ holding the runner and a fake ERT.
fresh() {
  rm -rf "$work/bin"; mkdir -p "$work/bin"
  cp "$repo_root/bin/test-all" "$work/bin/test-all"
  printf '#!/usr/bin/env bash\n%s\n' "${1:-echo 'Ran 3 tests, 3 results as expected, 0 unexpected'}" > "$work/bin/test"
  chmod +x "$work/bin/test"
}
suite() { # name body
  printf '#!/usr/bin/env bash\n%s\n' "$2" > "$work/bin/$1"; chmod +x "$work/bin/$1"
}
run() { "$work/bin/test-all" > "$work/out" 2>&1; echo $?; }
line_for() { grep -E "^  (ok|FAIL) +$1 " "$work/out" | awk '{print $1}'; }

fresh; suite good-test 'echo "ok - a"; echo "good-test: 2 passed, 0 failed"'
check "a clean suite passes" 0 "$(run)"
check "and is reported ok" ok "$(line_for good-test)"
check "the ERT count is read" yes "$(grep -qE '^  ok +test +3 passed' "$work/out" && echo yes || echo no)"
check "the total names the suites" yes "$(grep -q '^test-all: 2 suites, 5 passed, 0 failed' "$work/out" && echo yes || echo no)"

fresh; suite bad-test 'echo "FAIL - b"; echo "bad-test: 1 passed, 1 failed"; exit 1'
check "a failing suite fails the run" 1 "$(run)"
check "and is named" FAIL "$(line_for bad-test)"
check "and its output is shown" yes "$(grep -q '| FAIL - b' "$work/out" && echo yes || echo no)"

fresh; suite quiet-test 'echo "All tests passed."'
check "exit 0 with no final line fails" 1 "$(run)"
check "and says the line is missing" yes "$(grep -q 'no final `quiet-test: N passed' "$work/out" && echo yes || echo no)"

fresh; suite empty-test 'echo "empty-test: 0 passed, 0 failed"'
check "a suite that passed nothing fails" 1 "$(run)"

fresh; suite wrap-test 'echo "wrap-test: 1 passed, 256 failed"; exit 256'
check "256 failures, whose exit wraps to 0, still fail" 1 "$(run)"

fresh; suite liar-test 'echo "liar-test: 3 passed, 0 failed"; exit 1'
check "a clean count with a non-zero exit fails" 1 "$(run)"

fresh; suite other-test 'echo "someone-else-test: 3 passed, 0 failed"'
check "another suite's name in the line does not count" 1 "$(run)"

# Spelled in two pieces, or this file would itself read as a peeking suite.
fresh; suite peek-test 'grep -c . "$repo''_root/TODO.org"; echo "peek-test: 1 passed, 0 failed"'
check "a suite reading the real tracker fails statically" 1 "$(run)"
check "and says why" yes "$(grep -q 'reads real user data' "$work/out" && echo yes || echo no)"

fresh; suite env-test 'echo "sid=${CLAUDE_CODE_SESSION_ID:-unset}"; [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || exit 1; case "$CLAUDE_ORG_QUEUE_DIR" in "$HOME"/.claude*) exit 1;; esac; echo "env-test: 1 passed, 0 failed"'
check "session id unset and queue redirected" 0 \
  "$(CLAUDE_CODE_SESSION_ID=sess-real CLAUDE_ORG_QUEUE_DIR="$HOME/.claude/org-queue" "$work/bin/test-all" >/dev/null 2>&1; echo $?)"

fresh 'echo "Ran 3 tests, 2 results as expected, 1 unexpected"; exit 1'
check "an ERT failure fails the run" 1 "$(run)"
fresh 'echo "Loading..."'
check "ERT with no Ran line fails" 1 "$(run)"
fresh 'echo "Ran 0 tests, 0 results as expected, 0 unexpected"'
check "ERT running zero tests fails" 1 "$(run)"

echo
echo "test-all-test: $pass passed, $fail failed"
exit $((fail > 0))
