#!/usr/bin/env bash
# Shell test harness for the two PreToolUse guards (TODO.org :ID:
# 3cd7b7d3): bin/hooks/emacsclient-guard and bin/hooks/generated-guard.
# Same register as bin/queue-append-test. A guard blocks with exit 2 and a
# message on stderr, and counts itself as a miss.
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
export CLAUDE_ORG_QUEUE_DIR="$tmp/queue"

failures=0
check() {
  if [[ "$2" == "$3" ]]; then echo "ok   - $1"
  else echo "FAIL - $1: wanted [$2], got [$3]"; failures=$((failures + 1)); fi
}
rule_of() { jq -r 'select(.kind=="miss") | .rule' "$tmp/queue/$1.jsonl" 2>/dev/null | tail -1; }

# --- emacsclient-guard ---------------------------------------------------
g="$repo_root/bin/hooks/emacsclient-guard"
bash_call() { jq -n -c --arg c "$2" --arg s "$1" '{session_id:$s, hook_event_name:"PreToolUse", tool_name:"Bash", tool_input:{command:$c}}'; }
run_g() { bash_call "$1" "$2" | "$g" 2>"$tmp/err"; echo $?; }

check "a direct org-todo through emacsclient is blocked" 2 \
  "$(run_g e1 "emacsclient -e '(with-current-buffer \"TODO.org\" (org-todo \"DONE\"))'")"
check "the block says why" yes "$(grep -q 'queue' "$tmp/err" && echo yes || echo no)"
check "and is counted as a miss" "emacsclient-state" "$(rule_of e1)"
check "org-clock-in through emacsclient is blocked" 2 "$(run_g e2 "emacsclient --eval '(org-clock-in)'")"
check "org-clock-out through emacsclient is blocked" 2 "$(run_g e2 "emacsclient -e \"(org-clock-out)\"")"
check "the documented stale-interval recovery call is allowed" 0 \
  "$(run_g e3 "emacsclient -e '(claude-code-ide-org-close-open-interval \"id\" \"[2026-09-01 Tue 10:00]\")'")"
check "a read-only emacsclient call is allowed" 0 "$(run_g e3 "emacsclient -e '(org-get-todo-state)'")"
check "org-todo-keywords is a variable, not the command" 0 "$(run_g e3 "emacsclient -e 'org-todo-keywords'")"
check "grepping the source for org-todo is not emacsclient" 0 "$(run_g e3 "grep -n '(org-todo' config.el")"
check "an allowed call counts no miss" "" "$(rule_of e3)"
printf 'garbage' | "$g" >/dev/null 2>&1
check "garbage on stdin never blocks" 0 "$?"

# --- generated-guard -----------------------------------------------------
g2="$repo_root/bin/hooks/generated-guard"
mkdir -p "$tmp/p/.claude/rules" "$tmp/p/skills/org/references"
printf '<!-- Generated by claude-org-setup from skills/org/references/org-event-queue.md -->\n# x\n' > "$tmp/p/.claude/rules/org-event-queue.md"
printf -- '---\npaths:\n  - "**/*.org"\n---\n<!-- Generated by claude-org-setup -->\n' > "$tmp/p/.claude/rules/org-conventions.md"
printf '# hand-maintained\n' > "$tmp/p/.claude/rules/org-categories.md"
printf '# the reference\n' > "$tmp/p/skills/org/references/org-event-queue.md"
edit_call() { jq -n -c --arg f "$2" --arg s "$1" --arg t "${3:-Edit}" '{session_id:$s, hook_event_name:"PreToolUse", tool_name:$t, tool_input:{file_path:$f}}'; }
run_g2() { edit_call "$@" | "$g2" 2>"$tmp/err"; echo $?; }

check "editing a generated rule copy is blocked" 2 "$(run_g2 g1 "$tmp/p/.claude/rules/org-event-queue.md")"
check "the block names the reference to edit instead" yes \
  "$(grep -q 'skills/org/references/org-event-queue.md' "$tmp/err" && echo yes || echo no)"
check "and is counted as a miss" "generated-edit" "$(rule_of g1)"
check "the marker is found below frontmatter too" 2 "$(run_g2 g2 "$tmp/p/.claude/rules/org-conventions.md" Write)"
check "a hand-maintained rule file is allowed" 0 "$(run_g2 g3 "$tmp/p/.claude/rules/org-categories.md")"
check "the reference itself is allowed" 0 "$(run_g2 g3 "$tmp/p/skills/org/references/org-event-queue.md")"
check "a file that does not exist yet is allowed" 0 "$(run_g2 g3 "$tmp/p/.claude/rules/new.md" Write)"
printf 'garbage' | "$g2" >/dev/null 2>&1
check "garbage on stdin never blocks" 0 "$?"

echo
if [[ $failures -eq 0 ]]; then echo "tool-guards-test: all checks passed"
else echo "tool-guards-test: $failures check(s) failed"; fi
exit $((failures > 0))
