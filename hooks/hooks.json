{
  "description": "Session-tracking hooks for the org event queue. Every script here works against the queue (~/.claude/org-updates/<session>.jsonl) or the consuming repo's own tracked org files, and survives a stopped Emacs; none writes to an org file. Hooks that enforce claude-code-ide-org's OWN repo conventions are deliberately not shipped \u2014 they would assert conventions a consuming repo does not have, since CLAUDE_PROJECT_DIR is the consumer's root (doc-sync-check was removed for exactly that). TIME TRACKING IS WIRED BUT OFF: the guidepost, permission-block and clock rows are present and each self-gates on the plugin's `time_tracking` userConfig option, which defaults to false \u2014 so a consumer gets task tracking only until they turn it on in /config or with `--config time_tracking=true`. The gate lives in the scripts rather than here because hooks.json has no conditional form. A repo with its own .claude/settings.json wiring should NOT also enable this plugin's hooks, or every queue line is appended twice.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__emacs-tools__org_clock_in",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/queue-append clock_in",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__emacs-tools__org_clock_out",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/queue-append clock_out",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__emacs-tools__org_set_todo",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/queue-append todo",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__emacs-tools__org_capture",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/queue-append capture",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__emacs-tools__org_amend",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/queue-append amend",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/block-end",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/session-pause",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/footnote-check",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/clock-target-check",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/session-resume",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/apply-detect",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/session-start-recovery-check",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/block-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/hooks/block-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
